+// ---------------------------------------------------------------- KRC
+// Diffuse direct lighting of a vertex with the light of the frame (d_new) and that of the
+// previous frame (d_old), for the same sample: same lamp, same point, same shadow ray.
+// Copy of the game's get_direct_illumination / sample_polygonal_lights, diffuse, with one
+// difference: the lamp is sampled by max(intensity, previous intensity), so that a
+// lamp turning off is still sampled and its disappearance is measured.
+// Dynamic lamps and the sky are taken as identical before and after.
+void krc_direct(RcSurface s, vec3 view_dir, int bounce, out vec3 d_new, out vec3 d_old)
+{
+	d_new = vec3(0);
+	d_old = vec3(0);
+	vec3 p = s.position;
+	vec3 n = s.normal;
+	bool polygonal = bounce == 0 ? global_ubo.pt_direct_polygon_lights > 0 : global_ubo.pt_indirect_polygon_lights > 0;
+	bool dynamic = bounce == 0 ? global_ubo.pt_direct_dyn_lights > 0 : global_ubo.pt_indirect_dyn_lights > 0;
+
+	vec3 pl_pos = p, pl_new = vec3(0), pl_old = vec3(0);
+	if (polygonal && s.cluster != ~0u)
+	{
+		uint list_start = light_buffer.light_list_offsets[s.cluster];
+		uint list_end = light_buffer.light_list_offsets[s.cluster + 1];
+		uint light_count = list_end - list_start;
+		float partitions = ceil(float(light_count) / float(MAX_BRUTEFORCE_SAMPLING));
+		float u = rc_rand() * max(partitions, 1.0);
+		float fpart = min(floor(u), max(partitions - 1.0, 0.0));
+		u -= fpart;
+		uint first = list_start + uint(fpart);
+		uint stride = uint(max(partitions, 1.0));
+
+		float masses[MAX_BRUTEFORCE_SAMPLING];
+		float mass = 0.0;
+		for (uint i = 0u, li = first; i < MAX_BRUTEFORCE_SAMPLING; i++, li += stride)
+		{
+			masses[i] = 0.0;
+			if (li >= list_end)
+				continue;
+			uint idx = light_buffer.light_list_lights[li];
+			if (idx >= MAX_LIGHT_POLYS)
+				continue;
+			LightPolygon light = get_light_polygon(idx);
+			float m = spherical_tri_area(light.positions, p, n, view_dir, 1.0, 1.0, 0.0);
+			float style = max(light.light_style_scale, light.prev_style_scale);
+			m *= abs(luminance(light.color)) * (light.color.r >= 0 ? style : 1.0);
+			masses[i] = m;
+			mass += m;
+		}
+		if (mass > 0.0)
+		{
+			float r = u * mass;
+			uint pick = 0u;
+			float pdf = 0.0;
+			uint li = first;
+			for (uint i = 0u; i < MAX_BRUTEFORCE_SAMPLING; i++, li += stride)
+			{
+				if (li >= list_end)
+					break;
+				pick = li;
+				pdf = masses[i];
+				r -= masses[i];
+				if (r <= 0.0)
+					break;
+			}
+			pdf /= mass * max(partitions, 1.0);
+			uint idx = light_buffer.light_list_lights[pick];
+			if (pdf > 0.0 && idx < MAX_LIGHT_POLYS)
+			{
+				LightPolygon light = get_light_polygon(idx);
+				vec3 light_normal;
+				float pdfw;
+				pl_pos = sample_projected_triangle(p, light.positions, vec2(rc_rand(), rc_rand()), light_normal, pdfw);
+				vec3 L = normalize(pl_pos - p);
+				if (dot(L, n) > 0.0 && pdfw > 0.0)
+				{
+					float spotlight = sqrt(max(0.0, -dot(light_normal, L)));
+					if (light.color.r >= 0)
+					{
+						pl_new = light.color * (spotlight * light.light_style_scale / pdfw / pdf);
+						pl_old = light.color * (spotlight * light.prev_style_scale / pdfw / pdf);
+					}
+					else
+					{
+						pl_new = env_map(L, true) * (global_ubo.pt_env_scale / pdfw / pdf);
+						pl_old = pl_new;
+					}
+				}
+			}
+		}
+	}
+
+	vec3 dl_pos = p, dl = vec3(0);
+	if (dynamic)
+	{
+		vec3 rng3 = vec3(rc_rand(), rc_rand(), rc_rand());
+		sample_dynamic_lights(p, n, n, bounce == 0 ? 2.0 * M_PI : 0.02, dl_pos, dl, rng3);
+	}
+
+	float lp = luminance(max(abs(pl_new), abs(pl_old)));
+	float ld = luminance(abs(dl));
+	if (lp + ld <= 0.0)
+		return;
+	float w = lp / (lp + ld);
+	bool use_polygonal = rc_rand() < w;
+	vec3 pos = use_polygonal ? pl_pos : dl_pos;
+	vec3 c_new = use_polygonal ? pl_new / w : dl / (1.0 - w);
+	vec3 c_old = use_polygonal ? pl_old / w : dl / (1.0 - w);
+
+	float vis = trace_shadow_ray(get_shadow_ray(p - view_dir * 0.01, pos, 0), rc_shadow_mask());
+	float NdotL = max(0.0, dot(n, normalize(pos - p)));
+	d_new = c_new * (vis * NdotL / M_PI);
+	d_old = c_old * (vis * NdotL / M_PI);
+}
+
+// diffuse sun of a bounce vertex (identical before and after)
+vec3 krc_sun(RcSurface s, vec3 view_dir)
+{
+	rng_seed = rc_hash(rc_state ^ 0x51ed270bu);
+	rc_rand();
+	vec3 sun_diffuse, sun_specular;
+	get_sunlight(s.cluster, s.material_id, s.position, s.normal, s.normal, view_dir,
+		vec3(0), 0.0, 1.0, MEDIUM_NONE, false, sun_diffuse, sun_specular, rc_shadow_mask());
+	return sun_diffuse * global_ubo.sun_bounce_scale;
+}
+
+uint krc_alloc()
+{
+	KrcU64 ctr = krc_ctr();
+	uint n = uint(ctr.v[KRC_C_FREE]);
+	uint i = uint(atomicAdd(ctr.v[KRC_C_POP], uint64_t(1)));
+	if (i < n)
+		return krc_free().v[n - 1u - i];
+	uint c = uint(atomicAdd(ctr.v[KRC_C_CELLS], uint64_t(1)));
+	if (c >= global_ubo.rc_krc.y)
+	{
+		atomicAdd(ctr.v[KRC_C_OVERFLOW], uint64_t(1));
+		return KRC_NONE;
+	}
+	return c;
+}
+
+// cell of the key, created if needed; KRC_NONE if the table or the cells are full
+uint krc_insert(uint key)
+{
+	uint mask = global_ubo.rc_krc.x;
+	uint h = key & mask;
+	KrcU32 keys = krc_keys();
+	KrcU32 vals = krc_vals();
+	for (uint probe = 0u; probe < 64u; probe++)
+	{
+		uint k = keys.v[h];
+		if (k == key)
+		{
+			uint v = vals.v[h];
+			return v == 0u ? KRC_NONE : v - 1u;
+		}
+		if (k != 0u)
+		{
+			h = (h + 1u) & mask;
+			continue;
+		}
+		uint old = atomicCompSwap(keys.v[h], 0u, key);
+		if (old == 0u)
+		{
+			uint c = krc_alloc();
+			if (c == KRC_NONE)
+			{
+				keys.v[h] = KRC_TOMB;
+				return KRC_NONE;
+			}
+			KrcCell cell;
+			cell.mean = vec3(0);
+			cell.n = 0.0;
+			cell.lmean = 0.0;
+			cell.var = 0.0;
+			cell.seen = uint(krc_ctr().v[KRC_C_CLOCK]);
+			cell.key = key;
+			cell.slot = h + 1u;
+			cell.sigma = 0.0;
+			cell.born = cell.seen;
+			cell.pad = 0u;
+			krc_cells().c[c] = cell;
+			atomicExchange(vals.v[h], c + 1u);
+			return c;
+		}
+		if (old == key)
+		{
+			uint v = vals.v[h];
+			return v == 0u ? KRC_NONE : v - 1u;
+		}
+		h = (h + 1u) & mask;
+	}
+	return KRC_NONE;
+}
+
+// per-sample standard deviation of a cell for the allocation; a young cell gets a
+// priori large (exploration)
+float krc_sigma(uint c, float sigma_mean)
+{
+	KrcCell cell = krc_cells().c[c];
+	if (cell.n < 8.0)
+		return max(sigma_mean, 1e-3) * 4.0;
+	return max(cell.sigma, 1e-4);
+}
+
+// One indirect path from the pixel's primary surface: same first bounce as the game
+// (cosine around the shading normal, weight 1 - F), then up to pt_cache_bounces diffuse
+// bounces, stopping on a mature cell at the 1st or 2nd vertex (cache resampling).
+// value: estimate with the frame's light; old: the same with the previous one.
+void krc_path(ivec2 ipos, RcSurface s, vec3 view_dir, out vec3 value, out vec3 old)
+{
+	value = vec3(0);
+	old = vec3(0);
+
+	vec3 normal = decode_normal(texelFetch(TEX_PT_NORMAL_A, ipos, 0).x);
+	if (dot(normal, view_dir) > 0)
+		normal = -normal;
+	vec4 base_color = texelFetch(TEX_PT_BASE_COLOR_A, ipos, 0);
+	float metallic = texelFetch(TEX_PT_METALLIC_A, ipos, 0).x;
+	vec3 albedo, base_reflectivity;
+	get_reflectivity(base_color.rgb, metallic, albedo, base_reflectivity);
+
+	vec2 u = vec2(rc_rand(), rc_rand());
+	vec3 dir = normalize(construct_ONB_frisvad(normal) * sample_cos_hemisphere(u));
+	vec3 H = normalize(dir - view_dir);
+	vec3 F = schlick_fresnel(base_reflectivity, max(0.0, dot(-view_dir, H)), base_color.a);
+	vec3 beta = vec3(1.0) - F;
+
+	Ray ray;
+	ray.origin = s.position - view_dir * 0.01;
+	ray.direction = dir;
+	ray.t_min = 0;
+	ray.t_max = 10000;
+	trace_geometry_ray(ray, true, rc_bounce_mask());
+	if (!found_intersection(ray_payload_geometry))
+		return;
+
+	int bounces = max(int(global_ubo.pt_cache_bounces), 1);
+	uint rs_depth = rc_rand() < 0.5 ? 1u : 2u;
+	bool from_primary = true;
+	for (int b = 1; ; b++)
+	{
+		float segment = ray_payload_geometry.hit_distance;
+		vec3 sky;
+		RcSurface h;
+		if (!rc_hit_surface(dir, from_primary, h, sky))
+		{
+			value += beta * sky;
+			old += beta * sky;
+			return;
+		}
+		from_primary = false;
+		vec3 emissive = h.analytic_light ? vec3(0) : h.emissive;
+
+		vec3 d_new, d_old;
+		rng_seed = rc_hash(rc_state ^ 0x2545f491u);
+		krc_direct(h, dir, 1, d_new, d_old);
+		vec3 sun = krc_sun(h, dir);
+		if (b == 1)
+		{
+			// sun attenuation at the first bounce, like the game
+			float sun_attenuation = square(clamp(1.0 - square(square(segment / global_ubo.pt_sun_bounce_range)), 0, 1));
+			sun *= sun_attenuation;
+		}
+
+		// resampling: the rest of the path is read from a mature cell far enough away
+		if (uint(b) == rs_depth)
+		{
+			float size;
+			float dist = length(h.position - global_ubo.cam_pos.xyz);
+			uint key = krc_key(h.position, h.normal, dist, vec3(rc_rand(), rc_rand(), rc_rand()) - 0.5, size);
+			if (segment > size * 1.7320508)
+			{
+				uint c = krc_find(key);
+				if (c != KRC_NONE && krc_cells().c[c].n >= 8.0)
+				{
+					vec3 cached = krc_cells().c[c].mean;
+					value += beta * (h.albedo * (d_new + sun + cached) + emissive);
+					old += beta * (h.albedo * (d_old + sun + cached) + emissive);
+					return;
+				}
+			}
+		}
+
+		value += beta * (h.albedo * (d_new + sun) + emissive);
+		old += beta * (h.albedo * (d_old + sun) + emissive);
+		if (b >= bounces)
+			return;
+
+		beta *= h.albedo;
+		if (b >= 2)
+		{
+			float q = clamp(max(beta.x, max(beta.y, beta.z)), 0.05, 0.95);
+			if (rc_rand() > q)
+				return;
+			beta /= q;
+		}
+
+		vec3 nd;
+		bool found = rc_bounce(h, dir, nd);
+		dir = nd;
+		if (!found)
+			return;
+	}
+}
+
+void krc_add(uint i, float v)
+{
+	atomicAdd(krc_acc().v[i], uint64_t(int64_t(v * KRC_FX)));
+}
+
+// pass 2: counters of the frame
+void krc_prep()
+{
+	KrcU64 ctr = krc_ctr();
+	ctr.v[KRC_C_SIG_PREV] = ctr.v[KRC_C_SIG];
+	ctr.v[KRC_C_PIX_PREV] = ctr.v[KRC_C_PIX];
+	ctr.v[KRC_C_SIG] = 0;
+	ctr.v[KRC_C_PIX] = 0;
+	ctr.v[KRC_C_NVIS] = 0;
+	ctr.v[KRC_C_CLOCK] += 1;
+}
+
+// pass 3: the pixel's K cells (created if needed), then its paths: the pixel picks one
+// of its cells and sends it on average pt_krc_ppp × sigma / mean sigma paths (Neyman
+// allocation: more paths where the light varies)
+void krc_pixel(ivec2 ipos)
+{
+	if (ipos.x >= global_ubo.width || ipos.y >= global_ubo.height)
+		return;
+	if (uint(global_ubo.width) * uint(global_ubo.height) > global_ubo.rc_krc.z)
+		return;
+	uint idx = uint(ipos.y) * uint(global_ubo.width) + uint(ipos.x);
+	KrcU32 pix = krc_pix();
+
+	RcSurface s;
+	vec3 view_dir;
+	if (!rc_primary_surface(ipos, s, view_dir))
+	{
+		for (uint k = 0u; k < KRC_K; k++)
+			pix.v[idx * KRC_K + k] = KRC_NONE;
+		return;
+	}
+
+	rc_state = rc_hash(idx * 0x9e3779b9u + rc_hash(global_ubo.rc_addr_b.w));
+	float dist = length(s.position - global_ubo.cam_pos.xyz);
+	KrcU64 acc = krc_acc();
+	KrcU64 ctr = krc_ctr();
+	uint my_cells[KRC_K];
+	for (uint k = 0u; k < KRC_K; k++)
+	{
+		float size;
+		uint key = krc_key(s.position, s.normal, dist, vec3(rc_rand(), rc_rand(), rc_rand()) - 0.5, size);
+		uint c = krc_insert(key);
+		my_cells[k] = c;
+		pix.v[idx * KRC_K + k] = c;
+		if (c != KRC_NONE && atomicAdd(acc.v[c * KRC_ACC + KRC_A_FOOT], uint64_t(1)) == 0)
+			krc_vis().v[uint(atomicAdd(ctr.v[KRC_C_NVIS], uint64_t(1)))] = c;
+	}
+
+	uint c = my_cells[min(uint(rc_rand() * KRC_K), KRC_K - 1u)];
+	if (c == KRC_NONE)
+		return;
+	float pix_prev = float(ctr.v[KRC_C_PIX_PREV]);
+	float sigma_mean = pix_prev > 0 ? float(ctr.v[KRC_C_SIG_PREV]) / KRC_FX / pix_prev : 0.0;
+	float sigma = krc_sigma(c, sigma_mean);
+	atomicAdd(ctr.v[KRC_C_SIG], uint64_t(sigma * KRC_FX));
+	atomicAdd(ctr.v[KRC_C_PIX], uint64_t(1));
+	float p = global_ubo.pt_krc_ppp * (sigma_mean > 0 ? sigma / sigma_mean : 1.0);
+	int paths = int(floor(min(p, 4.0) + rc_rand()));
+
+	KrcCell cell = krc_cells().c[c];
+	for (int j = 0; j < paths; j++)
+	{
+		vec3 v, o;
+		krc_path(ipos, s, view_dir, v, o);
+		v = clamp_output(v);
+		o = clamp_output(o);
+		// firefly clamping: a sample more than 50× the mean of a mature cell
+		float l = luminance(v);
+		if (cell.n >= 8.0 && l > 50.0 * max(cell.lmean, 1e-3))
+		{
+			float k = 50.0 * max(cell.lmean, 1e-3) / l;
+			v *= k;
+			o *= k;
+			l *= k;
+		}
+		uint b = c * KRC_ACC;
+		atomicAdd(acc.v[b + KRC_A_FN], uint64_t(1));
+		krc_add(b + KRC_A_SUM + 0u, v.x);
+		krc_add(b + KRC_A_SUM + 1u, v.y);
+		krc_add(b + KRC_A_SUM + 2u, v.z);
+		krc_add(b + KRC_A_LUM, l);
+		krc_add(b + KRC_A_LUM2, l * l);
+		vec3 d = v - o;
+		krc_add(b + KRC_A_DELTA + 0u, d.x);
+		krc_add(b + KRC_A_DELTA + 1u, d.y);
+		krc_add(b + KRC_A_DELTA + 2u, d.z);
+	}
+}
+
+// pass 4: the free list after the insertions
+void krc_mid()
+{
+	KrcU64 ctr = krc_ctr();
+	uint64_t nf = ctr.v[KRC_C_FREE];
+	ctr.v[KRC_C_FREE] = nf - min(ctr.v[KRC_C_POP], nf);
+	ctr.v[KRC_C_POP] = 0;
+}
+
