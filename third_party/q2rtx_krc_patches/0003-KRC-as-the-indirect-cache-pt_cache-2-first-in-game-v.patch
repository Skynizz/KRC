diff --git a/src/refresh/vkpt/shader/indirect_lighting.rgen b/src/refresh/vkpt/shader/indirect_lighting.rgen
index f5b5b857..043124bb 100644
--- a/src/refresh/vkpt/shader/indirect_lighting.rgen
+++ b/src/refresh/vkpt/shader/indirect_lighting.rgen
@@ -37,6 +37,11 @@ with this program; if not, write to the Free Software Foundation, Inc.,
 
 layout(constant_id = 0) const uint spec_bounce_index = 0;
 
+// KRC (pt_cache 2): diffuse indirect of the pixel read from its cells, added to the LF channel
+vec3 krc_lf = vec3(0);
+vec3 krc_lf_direction = vec3(0, 0, 1);
+bool krc_used = false;
+
 void
 indirect_lighting(
 	ivec2 ipos, 
@@ -211,6 +216,29 @@ indirect_lighting(
 		}
 	}
 
+	// KRC: the diffuse indirect comes from the pixel's cells (same quantity as the game's diffuse
+	// bounce, 1 - F included, with every bounce); the diffuse ray is no longer traced, nor the
+	// second bounce that would follow it. The specular reflection stays the game's. As long as the
+	// pixel's cells have no sample, the game traces its diffuse ray as before.
+	if (spec_bounce_index == 0 && cache_mode() == CACHE_KRC)
+	{
+		vec3 cell_value;
+		if (krc_pixel_indirect(ipos, cell_value))
+		{
+			krc_lf = throughput.rgb * cell_value;
+			krc_lf_direction = normal;
+			krc_used = true;
+			if (!is_specular_ray)
+			{
+				bounce_direction = normal;
+				bounce_contrib = vec3(0);
+				if(spec_bounce_index < global_ubo.pt_num_bounce_rays - 1)
+					imageStore(IMG_PT_SHADING_POSITION, ipos, vec4(0));
+				return;
+			}
+		}
+	}
+
 	Ray bounce_ray;
 	bounce_ray.origin = position;
 	bounce_ray.direction = bounce_direction;
@@ -523,6 +551,27 @@ main()
 
 	indirect_lighting(ipos, half_res, bounce_direction, bounce_contrib, is_specular_ray);
 
+	if (global_ubo.pt_cache_debug == 1 && spec_bounce_index == 0 && cache_mode() == CACHE_KRC)
+	{
+		krc_lf = krc_used ? vec3(0, 2, 0) : vec3(2, 0, 0);
+		krc_used = true;
+	}
+
+	if (krc_used && !any(isnan(krc_lf)) && !any(isinf(krc_lf)))
+	{
+		vec3 lf = clamp_output(krc_lf) * STORAGE_SCALE_LF;
+		SH low_freq = load_SH(TEX_PT_COLOR_LF_SH, TEX_PT_COLOR_LF_COCG, ipos);
+	#if ENABLE_SH
+		if(global_ubo.flt_enable == 0)
+			low_freq.shY.xyz += lf;
+		else
+			accumulate_SH(low_freq, irradiance_to_SH(lf, krc_lf_direction), 1.0);
+	#else
+		low_freq.shY.xyz += lf;
+	#endif
+		STORE_SH(IMG_PT_COLOR_LF_SH, IMG_PT_COLOR_LF_COCG, ipos, low_freq);
+	}
+
 	if(any(isinf(bounce_contrib)) || any(isnan(bounce_contrib)) || any(isinf(bounce_direction)) || any(isnan(bounce_direction)) )
 		return;
 
diff --git a/src/refresh/vkpt/shader/radiance_cache.h b/src/refresh/vkpt/shader/radiance_cache.h
index 8fb70219..551b3808 100644
--- a/src/refresh/vkpt/shader/radiance_cache.h
+++ b/src/refresh/vkpt/shader/radiance_cache.h
@@ -63,4 +63,162 @@ vec3 rc_demodulation(vec3 albedo)
 	return max(albedo, vec3(0.05));
 }
 
+// ========================================================================== //
+// KRC (pt_cache 2). World-space cells, sized ≈ pt_krc_cell_px pixels
+// on screen (power-of-2 levels by distance) and per face (dominant axis
+// of the normal). Each pixel reads K = 4 cells, randomly offset
+// by at most half a cell: the pixel's diffuse indirect is their truncated
+// mean. A cell stores the same quantity as the game's LF channel
+// (demodulated diffuse indirect, with the game's 1 - F factor).
+// ========================================================================== //
+
+layout(buffer_reference, std430, buffer_reference_align = 4) buffer KrcU32 { uint v[]; };
+layout(buffer_reference, std430, buffer_reference_align = 8) buffer KrcU64 { uint64_t v[]; };
+
+struct KrcCell
+{
+	vec3 mean;      // mean indirect (demodulated)
+	float n;        // samples in the history (capped at pt_krc_hist)
+	float lmean;    // luminance moyenne
+	float var;      // per-sample variance of the luminance (running mean)
+	uint seen;      // last frame (KRC clock) where the cell was used
+	uint key;
+	uint slot;      // table slot + 1 (0: free)
+	float sigma;    // per-sample standard deviation (Neyman allocation)
+	uint born;
+	uint pad;
+};
+layout(buffer_reference, std430, buffer_reference_align = 16) buffer KrcCells { KrcCell c[]; };
+
+#define KRC_K        4
+#define KRC_NONE     0xffffffffu
+#define KRC_TOMB     0xffffffffu
+#define KRC_FX       65536.0
+// accumulators per cell (64 bits, KRC_FX fixed point)
+#define KRC_ACC      10
+#define KRC_A_FOOT   0   // pixels that read the cell in the frame
+#define KRC_A_FN     1   // samples of the frame
+#define KRC_A_SUM    2   // 2..4 : somme rgb
+#define KRC_A_LUM    5
+#define KRC_A_LUM2   6
+#define KRC_A_DELTA  7   // 7..9: rgb sum of the "after - before" differences (signed)
+// compteurs (64 bits)
+#define KRC_C_CELLS     0
+#define KRC_C_NVIS      1
+#define KRC_C_FREE      2
+#define KRC_C_POP       3
+#define KRC_C_SIG       4   // Σ sigma of the sampling pixels (fixed point)
+#define KRC_C_PIX       5
+#define KRC_C_SIG_PREV  6
+#define KRC_C_PIX_PREV  7
+#define KRC_C_CLOCK     8
+#define KRC_C_OVERFLOW  9
+
+KrcU32 krc_keys()  { return KrcU32(rc_address(global_ubo.rc_addr_c.xy)); }
+KrcU32 krc_vals()  { return KrcU32(rc_address(global_ubo.rc_addr_c.zw)); }
+KrcCells krc_cells() { return KrcCells(rc_address(global_ubo.rc_addr_d.xy)); }
+KrcU64 krc_acc()   { return KrcU64(rc_address(global_ubo.rc_addr_d.zw)); }
+KrcU64 krc_ctr()   { return KrcU64(rc_address(global_ubo.rc_addr_e.xy)); }
+KrcU32 krc_vis()   { return KrcU32(rc_address(global_ubo.rc_addr_e.zw)); }
+KrcU32 krc_free()  { return KrcU32(rc_address(global_ubo.rc_addr_f.xy)); }
+KrcU32 krc_pix()   { return KrcU32(rc_address(global_ubo.rc_addr_f.zw)); }
+
+uint krc_mix(uint h, uint v)
+{
+	h ^= v + 0x9e3779b9u + (h << 6) + (h >> 2);
+	h ^= h >> 16; h *= 0x7feb352du;
+	h ^= h >> 15; h *= 0x846ca68bu;
+	h ^= h >> 16;
+	return h;
+}
+
+// angle (in radians) covered by a pixel
+float krc_pixel_angle()
+{
+	return 2.0 / (abs(global_ubo.P[1][1]) * float(global_ubo.height));
+}
+
+// key of the cell of point p (normal n, at distance dist from the camera), offset by
+// jitter (in fractions of a cell)
+uint krc_key(vec3 p, vec3 n, float dist, vec3 jitter, out float size)
+{
+	float target = global_ubo.pt_krc_cell_px * max(dist, 1.0) * krc_pixel_angle();
+	int level = int(floor(log2(max(target, 1e-3)) + 0.5));
+	size = exp2(float(level));
+	ivec3 q = ivec3(floor(p / size + jitter));
+	vec3 an = abs(n);
+	uint axis = (an.x >= an.y && an.x >= an.z) ? 0u : ((an.y >= an.z) ? 1u : 2u);
+	float sgn = (axis == 0u) ? n.x : ((axis == 1u) ? n.y : n.z);
+	uint face = axis * 2u + (sgn < 0.0 ? 1u : 0u);
+	uint h = krc_mix(0x12345u, uint(q.x));
+	h = krc_mix(h, uint(q.y));
+	h = krc_mix(h, uint(q.z));
+	h = krc_mix(h, uint(level + 128) * 8u + face);
+	if (h == 0u || h == KRC_TOMB)
+		h = 1u;
+	return h;
+}
+
+// existing cell for the key, or KRC_NONE
+uint krc_find(uint key)
+{
+	uint mask = global_ubo.rc_krc.x;
+	uint h = key & mask;
+	KrcU32 keys = krc_keys();
+	for (uint probe = 0u; probe < 64u; probe++)
+	{
+		uint k = keys.v[h];
+		if (k == key)
+		{
+			uint v = krc_vals().v[h];
+			return v == 0u ? KRC_NONE : v - 1u;
+		}
+		if (k == 0u)
+			return KRC_NONE;
+		h = (h + 1u) & mask;
+	}
+	return KRC_NONE;
+}
+
+// diffuse indirect of a pixel (LF channel): truncated mean of its K cells (without the
+// brightest or the darkest when there are 4); false if no cell has a sample
+bool krc_pixel_indirect(ivec2 ipos, out vec3 value)
+{
+	value = vec3(0);
+	uint idx = uint(ipos.y) * uint(global_ubo.width) + uint(ipos.x);
+	if (uint(global_ubo.width) * uint(global_ubo.height) > global_ubo.rc_krc.z)
+		return false;
+	KrcU32 pix = krc_pix();
+	KrcCells cells = krc_cells();
+	vec3 vals[KRC_K];
+	uint nv = 0u;
+	for (uint s = 0u; s < KRC_K; s++)
+	{
+		uint c = pix.v[idx * KRC_K + s];
+		if (c != KRC_NONE && cells.c[c].n > 0.0)
+			vals[nv++] = cells.c[c].mean;
+	}
+	if (nv == 0u)
+		return false;
+	if (nv == KRC_K)
+	{
+		uint imin = 0u, imax = 0u;
+		for (uint s = 1u; s < KRC_K; s++)
+		{
+			if (luminance(vals[s]) < luminance(vals[imin])) imin = s;
+			if (luminance(vals[s]) >= luminance(vals[imax])) imax = s;
+		}
+		if (imin == imax) imax = (imin + 1u) % KRC_K;
+		for (uint s = 0u; s < KRC_K; s++)
+			if (s != imin && s != imax) value += vals[s];
+		value *= 0.5;
+	}
+	else
+	{
+		for (uint s = 0u; s < nv; s++) value += vals[s];
+		value /= float(nv);
+	}
+	return true;
+}
+
 #endif // RADIANCE_CACHE_H_
