 src/refresh/vkpt/shader/radiance_cache.h      | 158 ++++++
 src/refresh/vkpt/shader/radiance_cache.rgen   | 506 +++++++++++++++++-
 src/refresh/vkpt/vkpt.h                       |   1 +
 8 files changed, 823 insertions(+), 21 deletions(-)

