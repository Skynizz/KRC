@@ -1116,6 +1116,7 @@ vkpt_pt_trace_reflections(VkCommandBuffer cmd_buf, int bounce)
 
 extern cvar_t *cvar_pt_cache;
 extern cvar_t *cvar_pt_sharc_downscale;
+extern cvar_t *cvar_pt_krc_passes;
 
 static void
 cache_barrier(VkCommandBuffer cmd_buf)
@@ -1146,15 +1147,30 @@ trace_radiance_cache(VkCommandBuffer cmd_buf)
 	push.gpu_index = -1;
 	push.bounce = 0;
 
-	uint32_t ds = (uint32_t)max(1, (int)cvar_pt_sharc_downscale->value);
-	uint32_t w = (qvk.extent_render.width + ds - 1) / ds;
-	uint32_t h = (qvk.extent_render.height + ds - 1) / ds;
-	dispatch_rays(cmd_buf, PIPELINE_CACHE_UPDATE, push, w, h, 1);
