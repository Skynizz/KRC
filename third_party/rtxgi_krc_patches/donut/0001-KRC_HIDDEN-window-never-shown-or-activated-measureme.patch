From 2555adddb72c6471793c42376864c21ac5fa9769 Mon Sep 17 00:00:00 2001
From: Skynizz <182822215+Skynizz@users.noreply.github.com>
Date: Sat, 24 Oct 2026 23:49:43 +0200
Subject: [PATCH] KRC_HIDDEN: window never shown or activated (measurements without a screen)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 src/app/DeviceManager.cpp | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/src/app/DeviceManager.cpp b/src/app/DeviceManager.cpp
index b40faab..79820bb 100644
--- a/src/app/DeviceManager.cpp
+++ b/src/app/DeviceManager.cpp
@@ -465,8 +465,14 @@ bool DeviceManager::CreateWindowDeviceAndSwapChain(const DeviceCreationParameter
     if (!CreateSwapChain())
         return false;
 
-    glfwShowWindow(m_Window);
-    glfwFocusWindow(m_Window);
+    // KRC_HIDDEN=1 (krc branch): the window is never shown or activated, for measurements
+    // while the screen is used for something else; rendering goes on (see ShouldRenderUnfocused)
+    const char* hidden = getenv("KRC_HIDDEN");
+    if (!(hidden && atoi(hidden) != 0))
+    {
+        glfwShowWindow(m_Window);
+        glfwFocusWindow(m_Window);
+    }
 
     if (m_DeviceParams.startMaximized)
     {
-- 
2.55.0.windows.3

