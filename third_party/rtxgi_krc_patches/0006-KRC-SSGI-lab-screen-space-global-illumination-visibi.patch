+
+// Screen-space global illumination (Shaders/KrcScreenGI.hlsl): lab for the ReShade effect. Four passes:
+// trace, temporal accumulation, à-trous filter, composite. Resources created on the first call.
+namespace
+{
+struct KrcSsgiConstantsCpu
+{
+    float radius, thickness, intensity, maxRadiusPixels;
+    int slices, steps, frame, gbufferNormals;
+    int gbufferAlbedo, historyMax, filterStep, debug;
+};
+}
+
+void Pathtracer::KrcScreenGI(nvrhi::ITexture* color)
+{
+    nvrhi::IDevice* device = GetDevice();
+    const nvrhi::TextureDesc& colorDesc = color->getDesc();
+
+    if (!m_krcSsgiLayout)
+    {
+        nvrhi::BindingLayoutDesc layoutDesc;
+        layoutDesc.visibility = nvrhi::ShaderType::Compute;
+        layoutDesc.bindings = {
+            nvrhi::BindingLayoutItem::VolatileConstantBuffer(0),
+            nvrhi::BindingLayoutItem::VolatileConstantBuffer(1),
+            nvrhi::BindingLayoutItem::VolatileConstantBuffer(2),
+        };
+        for (uint32_t i = 0; i <= 11; i++)
+            layoutDesc.bindings.push_back(nvrhi::BindingLayoutItem::Texture_UAV(i));
+        m_krcSsgiLayout = device->createBindingLayout(layoutDesc);
+        m_krcSsgiConstants = device->createBuffer(nvrhi::utils::CreateVolatileConstantBufferDesc(sizeof(KrcSsgiConstantsCpu), "KrcSsgiConstants", 16));
+
+        auto makePso = [&](const char* entry) {
+            nvrhi::ComputePipelineDesc desc;
+            desc.bindingLayouts = { m_krcSsgiLayout };
+            desc.CS = m_shaderFactory->CreateShader("app/Shaders/KrcScreenGI.hlsl", entry, nullptr, nvrhi::ShaderType::Compute);
+            return device->createComputePipeline(desc);
+        };
+        m_krcSsgiTracePSO = makePso("krcSsgiTrace");
+        m_krcSsgiTemporalPSO = makePso("krcSsgiTemporal");
+        m_krcSsgiFilterPSO = makePso("krcSsgiFilter");
+        m_krcSsgiCompositePSO = makePso("krcSsgiComposite");
+    }
+
+    if (!m_krcSsgiOut || m_krcSsgiOut->getDesc().width != colorDesc.width || m_krcSsgiOut->getDesc().height != colorDesc.height)
+    {
+        auto makeTexture = [&](nvrhi::Format format, const char* name) {
+            nvrhi::TextureDesc desc;
+            desc.width = colorDesc.width;
+            desc.height = colorDesc.height;
+            desc.format = format;
+            desc.isUAV = true;
+            desc.keepInitialState = true;
+            desc.initialState = nvrhi::ResourceStates::UnorderedAccess;
+            desc.debugName = name;
+            return device->createTexture(desc);
+        };
+        m_krcSsgiRaw = makeTexture(nvrhi::Format::RGBA16_FLOAT, "KrcSsgiRaw");
+        m_krcSsgiHistory[0] = makeTexture(nvrhi::Format::RGBA16_FLOAT, "KrcSsgiHistory0");
+        m_krcSsgiHistory[1] = makeTexture(nvrhi::Format::RGBA16_FLOAT, "KrcSsgiHistory1");
+        m_krcSsgiPrevRadiance = makeTexture(nvrhi::Format::RGBA16_FLOAT, "KrcSsgiPrevRadiance");
+        m_krcSsgiPrevDepth = makeTexture(nvrhi::Format::R32_FLOAT, "KrcSsgiPrevDepth");
+        m_krcSsgiOut = makeTexture(nvrhi::Format::RGBA32_FLOAT, "KrcSsgiOut");
+        m_krcSsgiFilter[0] = makeTexture(nvrhi::Format::RGBA16_FLOAT, "KrcSsgiFilter0");
+        m_krcSsgiFilter[1] = makeTexture(nvrhi::Format::RGBA16_FLOAT, "KrcSsgiFilter1");
+        m_commandList->clearTextureFloat(m_krcSsgiHistory[0], nvrhi::AllSubresources, nvrhi::Color(0.0f));
+        m_commandList->clearTextureFloat(m_krcSsgiHistory[1], nvrhi::AllSubresources, nvrhi::Color(0.0f));
+        m_commandList->clearTextureFloat(m_krcSsgiPrevDepth, nvrhi::AllSubresources, nvrhi::Color(0.0f));
+    }
+
+    nvrhi::ITexture* historyPrev = m_krcSsgiHistory[m_krcSsgiFrame & 1];
+    nvrhi::ITexture* historyCur = m_krcSsgiHistory[(m_krcSsgiFrame + 1) & 1];
+    auto makeSet = [&](nvrhi::ITexture* filterIn, nvrhi::ITexture* filterOut) {
+        nvrhi::BindingSetDesc desc;
+        desc.bindings = {
+            nvrhi::BindingSetItem::ConstantBuffer(0, m_constantBuffer),
+            nvrhi::BindingSetItem::ConstantBuffer(1, m_debugBuffer),
+            nvrhi::BindingSetItem::ConstantBuffer(2, m_krcSsgiConstants),
+            nvrhi::BindingSetItem::Texture_UAV(0, color),
+            nvrhi::BindingSetItem::Texture_UAV(1, m_renderTargets->depth),
+            nvrhi::BindingSetItem::Texture_UAV(2, m_renderTargets->normalRoughness),
+            nvrhi::BindingSetItem::Texture_UAV(3, m_renderTargets->diffuseAlbedo),
+            nvrhi::BindingSetItem::Texture_UAV(4, m_krcSsgiRaw),
+            nvrhi::BindingSetItem::Texture_UAV(5, historyPrev),
+            nvrhi::BindingSetItem::Texture_UAV(6, historyCur),
+            nvrhi::BindingSetItem::Texture_UAV(7, m_krcSsgiPrevRadiance),
+            nvrhi::BindingSetItem::Texture_UAV(8, m_krcSsgiPrevDepth),
+            nvrhi::BindingSetItem::Texture_UAV(9, m_krcSsgiOut),
+            nvrhi::BindingSetItem::Texture_UAV(10, filterIn),
+            nvrhi::BindingSetItem::Texture_UAV(11, filterOut),
+        };
+        return device->createBindingSet(desc, m_krcSsgiLayout);
+    };
+
+    KrcSsgiConstantsCpu constants = {};
+    constants.radius = m_krcSsgi.radius;
+    constants.thickness = m_krcSsgi.thickness;
+    constants.intensity = m_krcSsgi.intensity;
+    constants.maxRadiusPixels = m_krcSsgi.maxRadiusPixels;
+    constants.slices = m_krcSsgi.slices;
+    constants.steps = m_krcSsgi.steps;
+    constants.frame = (int)m_krcSsgiFrame;
+    constants.gbufferNormals = m_krcSsgi.gbufferNormals;
+    constants.gbufferAlbedo = m_krcSsgi.gbufferAlbedo;
+    constants.historyMax = m_krcSsgi.historyMax;
+    constants.debug = m_krcSsgi.debug;
+
+    const uint32_t gx = (colorDesc.width + 7) / 8, gy = (colorDesc.height + 7) / 8;
+    auto run = [&](nvrhi::IComputePipeline* pso, nvrhi::IBindingSet* set, int filterStep) {
+        constants.filterStep = filterStep;
+        m_commandList->writeBuffer(m_krcSsgiConstants, &constants, sizeof(constants));
+        nvrhi::ComputeState state;
+        state.pipeline = pso;
+        state.bindings = { set };
+        m_commandList->setComputeState(state);
+        m_commandList->dispatch(gx, gy);
+    };
+
+    ScopedMarker marker(m_commandList, "KrcScreenGI");
+    nvrhi::BindingSetHandle base = makeSet(historyCur, m_krcSsgiFilter[0]);
+    run(m_krcSsgiTracePSO, base, 1);
+    run(m_krcSsgiTemporalPSO, base, 1);
+
+    // à-trous: history -> filter 0 -> filter 1 -> filter 0 ...
+    nvrhi::ITexture* in = historyCur;
+    int out = 0;
+    for (int i = 0; i < m_krcSsgi.filterPasses; i++)
+    {
+        nvrhi::BindingSetHandle set = makeSet(in, m_krcSsgiFilter[out]);
+        run(m_krcSsgiFilterPSO, set, 1 << i);
+        in = m_krcSsgiFilter[out];
+        out ^= 1;
+    }
+    nvrhi::BindingSetHandle composite = makeSet(in, m_krcSsgiFilter[out]);
+    run(m_krcSsgiCompositePSO, composite, 1);
+    m_krcSsgiFrame++;
+}
