diff --git a/Samples/Pathtracer/Shaders/KrcScreenGI.hlsl b/Samples/Pathtracer/Shaders/KrcScreenGI.hlsl
new file mode 100644
index 0000000..fea78e8
--- /dev/null
+++ b/Samples/Pathtracer/Shaders/KrcScreenGI.hlsl
@@ -0,0 +1,360 @@
+/*
+ * krc branch: screen-space global illumination (KRC-SSGI), lab for the ReShade effect.
+ *
+ * Inputs as in a game seen by ReShade: colour without indirect lighting and depth (plus,
+ * optionally, the G-buffer normals and albedo for the "ideal" version). Output: colour +
+ * albedo × indirect lighting. The full path tracer serves as the reference.
+ *
+ * 1. krcSsgiTrace: visibility bitmask (Therrien, Levesque, Gilet, "Screen Space Indirect
+ *    Lighting with Visibility Bitmask", 2023). Per slice (plane containing the view direction),
+ *    the depth buffer is marched; each hit point masks an interval of angles [front,
+ *    back] (assumed thickness), and the newly masked sectors receive its radiance
+ *    (previous frame: several bounces over time). Sectors spread at equal measure of
+ *    cos θ dω (GTAO integral), so the mean is the cosine-weighted incident radiance.
+ * 2. krcSsgiTemporal: accumulation with reprojection (camera) and depth rejection.
+ * 3. krcSsgiFilter: à-trous stopped at edges (depth, normal), steps 1, 2, 4.
+ * 4. krcSsgiComposite: colour + albedo × indirect; keeps the radiance and the depth.
+ */
+
+#include "../GlobalCb.h"
+#include "../LightingCb.h"
+
+#define KRC_PI 3.14159265f
+
+struct KrcSsgiConstants
+{
+    float radius;        // search radius (world units)
+    float thickness;     // assumed thickness of the surfaces (world units)
+    float intensity;
+    float maxRadiusPixels;
+
+    int slices;
+    int steps;           // steps per side
+    int frame;
+    int gbufferNormals;  // 1: G-buffer normals; 0: derived from depth (ReShade)
+
+    int gbufferAlbedo;   // 1: G-buffer albedo; 0: estimated from the colour (ReShade)
+    int historyMax;
+    int filterStep;      // step of the current à-trous pass
+    int debug;
+};
+
+ConstantBuffer<LightingConstants>   g_Lighting      : register(b0);
+ConstantBuffer<GlobalConstants>     g_Global        : register(b1);
+ConstantBuffer<KrcSsgiConstants>    g_Ssgi          : register(b2);
+
+RWTexture2D<float4> u_Color         : register(u0); // "game" colour (linear HDR)
+RWTexture2D<float>  u_Depth         : register(u1); // view-space z (0: sky)
+RWTexture2D<float4> u_NormalRough   : register(u2); // world normal (G-buffer)
+RWTexture2D<float4> u_Albedo        : register(u3); // diffuse albedo (G-buffer)
+RWTexture2D<float4> u_GiRaw         : register(u4); // mean incident radiance of the frame
+RWTexture2D<float4> u_HistoryPrev   : register(u5); // xyz incident radiance, w number of frames
+RWTexture2D<float4> u_HistoryCur    : register(u6);
+RWTexture2D<float4> u_PrevRadiance  : register(u7); // output of the previous frame
+RWTexture2D<float>  u_PrevDepth     : register(u8);
+RWTexture2D<float4> u_Output        : register(u9);
+RWTexture2D<float4> u_FilterIn      : register(u10);
+RWTexture2D<float4> u_FilterOut     : register(u11);
+
+uint2 ScreenSize()
+{
+    return uint2(g_Lighting.view.viewportSize);
+}
+
+bool InScreen(int2 p)
+{
+    return all(p >= 0) && all(p < int2(ScreenSize()));
+}
+
+// view-space position of a pixel of depth z
+float3 ViewPosition(float2 pixel, float z)
+{
+    const float2 clip = (pixel * g_Lighting.view.windowToClipScale) + g_Lighting.view.windowToClipBias;
+    float4 v = mul(float4(clip, 0.5f, 1.0f), g_Lighting.view.matClipToViewNoOffset);
+    v.xyz /= v.w;
+    return v.xyz * (z / v.z);
+}
+
+float3 ViewNormal(int2 p, float3 P)
+{
+    if (g_Ssgi.gbufferNormals != 0)
+        return normalize(mul(float4(u_NormalRough[p].xyz, 0.0f), g_Lighting.view.matWorldToView).xyz);
+
+    // derived from depth: the smaller of the differences on each side (sharp edges)
+    const float zl = u_Depth[p + int2(-1, 0)], zr = u_Depth[p + int2(1, 0)];
+    const float zu = u_Depth[p + int2(0, -1)], zd = u_Depth[p + int2(0, 1)];
+    const float3 Pl = ViewPosition(float2(p) + float2(-0.5f, 0.5f), zl), Pr = ViewPosition(float2(p) + float2(1.5f, 0.5f), zr);
+    const float3 Pu = ViewPosition(float2(p) + float2(0.5f, -0.5f), zu), Pd = ViewPosition(float2(p) + float2(0.5f, 1.5f), zd);
+    const float3 dx = (zl > 0 && abs(Pl.z - P.z) < abs(Pr.z - P.z)) || zr <= 0 ? P - Pl : Pr - P;
+    const float3 dy = (zu > 0 && abs(Pu.z - P.z) < abs(Pd.z - P.z)) || zd <= 0 ? P - Pu : Pd - P;
+    float3 n = normalize(cross(dy, dx));
+    if (dot(n, -P) < 0)
+        n = -n;
+    return n;
+}
+
+float3 ViewToWindow(float3 P)
+{
+    const float4 clip = mul(float4(P, 1.0f), g_Lighting.view.matViewToClipNoOffset);
+    return float3(clip.xy / clip.w * g_Lighting.view.clipToWindowScale + g_Lighting.view.clipToWindowBias, clip.w);
+}
+
+// radiance of a seen point: previous frame's output reprojected, failing that the current colour
+float3 SampleRadiance(int2 q, float3 Pq)
+{
+    const float3 world = mul(float4(Pq, 1.0f), g_Lighting.view.matViewToWorld).xyz;
+    const float4 prevClip = mul(float4(world, 1.0f), g_Lighting.viewPrev.matWorldToClipNoOffset);
+    const float2 prevPixel = prevClip.xy / prevClip.w * g_Lighting.viewPrev.clipToWindowScale + g_Lighting.viewPrev.clipToWindowBias;
+    const int2 pp = int2(prevPixel);
+    if (InScreen(pp))
+    {
+        const float prevZ = u_PrevDepth[pp];
+        const float expectedZ = dot(world - g_Lighting.viewPrev.matViewToWorld[3].xyz, g_Lighting.viewPrev.matViewToWorld[2].xyz);
+        if (prevZ > 0 && abs(prevZ - expectedZ) < 0.05f * expectedZ)
+            return u_PrevRadiance[pp].rgb;
+    }
+    return u_Color[q].rgb;
+}
+
+// ∫ cos(x − n) |sin x| dx from n − π/2 to t (GTAO measure in the slice)
+float SliceMeasure(float t, float n)
+{
+    const float sn = sin(n);
+    const float t0 = n - 0.5f * KRC_PI;
+    const float gm0 = cos(2.0f * t0 - n) * 0.25f - t0 * sn * 0.5f;
+    if (t <= 0.0f)
+        return (cos(2.0f * t - n) * 0.25f - t * sn * 0.5f) - gm0;
+    const float atZero = (cos(-n) * 0.25f) - gm0;
+    return atZero + (-cos(2.0f * t - n) * 0.25f + t * sn * 0.5f) - (-cos(-n) * 0.25f);
+}
+
+uint SectorMask(float ua, float ub)
+{
+    const uint a = uint(clamp(floor(saturate(ua) * 32.0f), 0.0f, 32.0f));
+    const uint b = uint(clamp(ceil(saturate(ub) * 32.0f), 0.0f, 32.0f));
+    const uint count = b > a ? b - a : 0u;
+    if (count == 0u)
+        return 0u;
+    return count >= 32u ? 0xffffffffu : (((1u << count) - 1u) << a);
+}
+
+float InterleavedNoise(uint2 p, uint frame)
+{
+    // low-discrepancy noise (Jimenez), shifted every frame
+    const float2 q = float2(p) + 5.588238f * float(frame & 63u);
+    return frac(52.9829189f * frac(dot(q, float2(0.06711056f, 0.00583715f))));
+}
+
+[numthreads(8, 8, 1)]
+void krcSsgiTrace(uint2 p : SV_DispatchThreadID)
+{
+    if (any(p >= ScreenSize()))
+        return;
+    const float z = u_Depth[p];
+    if (z <= 0.0f)
+    {
+        u_GiRaw[p] = float4(0, 0, 0, 1);
+        return;
+    }
+
+    const float3 P = ViewPosition(float2(p) + 0.5f, z);
+    const float3 V = normalize(-P);
+    const float3 N = ViewNormal(int2(p), P);
+
+    const float projScale = abs(g_Lighting.view.matViewToClipNoOffset[1][1]) * 0.5f * float(ScreenSize().y);
+    const float radiusPixels = min(g_Ssgi.radius * projScale / z, g_Ssgi.maxRadiusPixels);
+    const float marchPixels = max(radiusPixels, g_Ssgi.maxRadiusPixels); // further for the sky
+    const float noiseSlice = InterleavedNoise(p, uint(g_Ssgi.frame));
+    const float noiseStep = InterleavedNoise(p.yx + 17u, uint(g_Ssgi.frame) * 7u + 3u);
+
+    float3 gi = float3(0, 0, 0);
+    float visibility = 0.0f;
+    for (int s = 0; s < g_Ssgi.slices; s++)
+    {
+        const float phi = (float(s) + noiseSlice) / float(g_Ssgi.slices) * KRC_PI;
+        const float2 dir = float2(cos(phi), sin(phi));
+
+        // slice axes: x (screen direction in view space, orthogonal to V) and V
+        float3 x = float3(dir.x, -dir.y, 0.0f);
+        x = normalize(x - V * dot(x, V));
+        const float3 axis = cross(x, V);
+        const float3 Np = N - axis * dot(N, axis);
+        const float npLen = length(Np);
+        const float n = clamp(atan2(dot(Np, x), dot(Np, V)), -0.5f * KRC_PI + 1e-3f, 0.5f * KRC_PI - 1e-3f);
+        const float t0 = n - 0.5f * KRC_PI;
+        const float t1 = n + 0.5f * KRC_PI;
+        const float total = SliceMeasure(t1, n);
+
+        uint occluded = 0u;
+        uint skyBits = 0u;
+        float3 skyColor = float3(0, 0, 0);
+        float skyCount = 0.0f;
+        float3 sliceGi = float3(0, 0, 0);
+        for (int side = -1; side <= 1; side += 2)
+        {
+            float prevSkyU = -1.0f;
+            for (int i = 0; i < g_Ssgi.steps; i++)
+            {
+                const float f = (float(i) + noiseStep) / float(g_Ssgi.steps);
+                const float offset = max(f * f * marchPixels, float(i + 1));
+                const int2 q = int2(float2(p) + 0.5f + float(side) * dir * offset);
+                if (!InScreen(q))
+                    break;
+                const float zq = u_Depth[q];
+                if (zq <= 0.0f)
+                {
+                    // sky seen on screen: the camera rays along the slice lie in its
+                    // plane, and at infinity the direction from the pixel is the camera's; the
+                    // successive sky pixels cover the interval of angles between them
+                    const float3 D = normalize(ViewPosition(float2(q) + 0.5f, 1.0f));
+                    const float u = SliceMeasure(clamp(atan2(dot(D, x), dot(D, V)), t0, t1), n) / total;
+                    skyBits |= prevSkyU >= 0.0f ? SectorMask(min(u, prevSkyU), max(u, prevSkyU)) : SectorMask(u - 1.0f / 64.0f, u + 1.0f / 64.0f);
+                    skyColor += u_Color[q].rgb;
+                    skyCount += 1.0f;
+                    prevSkyU = u;
+                    continue;
+                }
+                prevSkyU = -1.0f;
+                const float3 Pq = ViewPosition(float2(q) + 0.5f, zq);
+                const float3 d = Pq - P;
+                const float dist = length(d);
+                if (dist > g_Ssgi.radius || dist < 1e-4f)
+                    continue;
+                const float3 db = d - V * g_Ssgi.thickness;
+                const float tf = clamp(atan2(dot(d, x), dot(d, V)), t0, t1);
+                const float tb = clamp(atan2(dot(db, x), dot(db, V)), t0, t1);
+                const float ua = SliceMeasure(min(tf, tb), n) / total;
+                const float ub = SliceMeasure(max(tf, tb), n) / total;
+                const uint mask = SectorMask(ua, ub);
+                const uint fresh = mask & ~occluded;
+                if (fresh != 0u)
+                {
+                    // the hit point only lights if it faces the pixel
+                    const float3 Nq = ViewNormal(q, Pq);
+                    const float facing = saturate(dot(Nq, -d / dist) * 4.0f);
+                    sliceGi += (float(countbits(fresh)) / 32.0f) * facing * SampleRadiance(q, Pq);
+                }
+                occluded |= mask;
+                if (occluded == 0xffffffffu)
+                    break;
+            }
+        }
+        if (skyCount > 0.0f)
+            sliceGi += (float(countbits(skyBits & ~occluded)) / 32.0f) * (skyColor / skyCount);
+        const float weight = npLen * total;
+        gi += weight * sliceGi;
+        visibility += weight * (1.0f - float(countbits(occluded)) / 32.0f);
+    }
+    gi /= float(g_Ssgi.slices);
+    visibility /= float(g_Ssgi.slices);
+    u_GiRaw[p] = float4(gi, visibility);
+}
+
+[numthreads(8, 8, 1)]
+void krcSsgiTemporal(uint2 p : SV_DispatchThreadID)
+{
+    if (any(p >= ScreenSize()))
+        return;
+    const float z = u_Depth[p];
+    const float4 current = u_GiRaw[p];
+    if (z <= 0.0f)
+    {
+        u_HistoryCur[p] = float4(0, 0, 0, 0);
+        return;
+    }
+    const float3 P = ViewPosition(float2(p) + 0.5f, z);
+    const float3 world = mul(float4(P, 1.0f), g_Lighting.view.matViewToWorld).xyz;
+    const float4 prevClip = mul(float4(world, 1.0f), g_Lighting.viewPrev.matWorldToClipNoOffset);
+    const float2 prevPixel = prevClip.xy / prevClip.w * g_Lighting.viewPrev.clipToWindowScale + g_Lighting.viewPrev.clipToWindowBias;
+    const int2 pp = int2(prevPixel);
+
+    float4 history = float4(0, 0, 0, 0);
+    if (InScreen(pp))
+    {
+        const float prevZ = u_PrevDepth[pp];
+        const float expectedZ = dot(world - g_Lighting.viewPrev.matViewToWorld[3].xyz, g_Lighting.viewPrev.matViewToWorld[2].xyz);
+        if (prevZ > 0 && abs(prevZ - expectedZ) < 0.03f * expectedZ)
+            history = u_HistoryPrev[pp];
+    }
+    const float frames = min(history.w + 1.0f, float(g_Ssgi.historyMax));
+    u_HistoryCur[p] = float4(lerp(history.xyz, current.xyz, 1.0f / frames), frames);
+}
+
+[numthreads(8, 8, 1)]
+void krcSsgiFilter(uint2 p : SV_DispatchThreadID)
+{
+    if (any(p >= ScreenSize()))
+        return;
+    const float z = u_Depth[p];
+    if (z <= 0.0f)
+    {
+        u_FilterOut[p] = float4(0, 0, 0, 0);
+        return;
+    }
+    const float3 P = ViewPosition(float2(p) + 0.5f, z);
+    const float3 N = ViewNormal(int2(p), P);
+    const float kernel[3] = { 3.0f / 8.0f, 1.0f / 4.0f, 1.0f / 16.0f };
+
+    float3 sum = float3(0, 0, 0);
+    float sumW = 0.0f;
+    for (int y = -2; y <= 2; y++)
+    {
+        for (int x = -2; x <= 2; x++)
+        {
+            const int2 q = int2(p) + int2(x, y) * g_Ssgi.filterStep;
+            if (!InScreen(q))
+                continue;
+            const float zq = u_Depth[q];
+            if (zq <= 0.0f)
+                continue;
+            const float3 Pq = ViewPosition(float2(q) + 0.5f, zq);
+            const float3 Nq = ViewNormal(q, Pq);
+            const float wPlane = exp(-abs(dot(N, Pq - P)) / (0.02f * z));
+            const float wNormal = pow(saturate(dot(N, Nq)), 16.0f);
+            const float w = kernel[abs(x)] * kernel[abs(y)] * wPlane * wNormal;
+            sum += w * u_FilterIn[q].xyz;
+            sumW += w;
+        }
+    }
+    u_FilterOut[p] = float4(sumW > 0.0f ? sum / sumW : u_FilterIn[p].xyz, u_FilterIn[p].w);
+}
+
+// albedo: G-buffer, or estimated from the colour (ReShade): tint of the colour, fixed brightness
+float3 Albedo(int2 p)
+{
+    if (g_Ssgi.gbufferAlbedo != 0)
+        return u_Albedo[p].rgb;
+    const float3 c = u_Color[p].rgb;
+    const float m = max(max(c.r, c.g), max(c.b, 1e-4f));
+    return 0.6f * c / m;
+}
+
+[numthreads(8, 8, 1)]
+void krcSsgiComposite(uint2 p : SV_DispatchThreadID)
+{
+    if (any(p >= ScreenSize()))
+        return;
+    const float z = u_Depth[p];
+    const float3 color = u_Color[p].rgb;
+    float3 result = color;
+    if (z > 0.0f)
+    {
+        const float3 gi = u_FilterIn[p].xyz;
+        result = color + g_Ssgi.intensity * Albedo(int2(p)) * gi;
+        if (g_Ssgi.debug == 1)
+            result = gi;
+        else if (g_Ssgi.debug == 2)
+            result = z.xxx;
+        else if (g_Ssgi.debug == 3)
+            result = ViewNormal(int2(p), ViewPosition(float2(p) + 0.5f, z)) * 0.5f + 0.5f;
+        else if (g_Ssgi.debug == 4)
+            result = u_GiRaw[p].www;
+        else if (g_Ssgi.debug == 5)
+            result = u_GiRaw[p].xyz;
+    }
+    else if (g_Ssgi.debug != 0)
+        result = float3(1, 0, 1);
+    u_Output[p] = float4(result, 1.0f);
+    u_PrevRadiance[p] = float4(result, 1.0f);
+    u_PrevDepth[p] = z;
+}
