+            if (any(p < 0) || any(p >= int2(size)))
+                continue;
+            const float z = u_OutputViewSpaceZ[p];
+            if (z == 0)
+                continue;
+            const float3 n = u_OutputNormalRoughness[p].xyz;
+            const float nd = saturate(dot(n0, n));
+            const float w = exp(-float(x * x + y * y) / 8.0f) * pow(nd, 8.0f) * exp(-abs(z - z0) / (0.03f * abs(z0)));
