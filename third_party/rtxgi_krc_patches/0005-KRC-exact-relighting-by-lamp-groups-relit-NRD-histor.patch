+/*
+ * krc branch: adaptation of the KRC library (Libraries/Krc/include/KrcRelight.h, exact relighting
+ * by lamp groups) to the sample path tracer: buffers in SHaRC's space (u7..u9) and
+ * LightingConstants settings.
+ */
+
+#ifndef KRC_RELIGHT_HLSLI
+#define KRC_RELIGHT_HLSLI
+
+#include "KrcRelight.h"
+
+#define KRC_RELIGHT_PARAMETERS(p)                       \
+    KrcRelightParameters p;                             \
+    p.groupAccumulationBuffer = u_KrcGroupAcc;          \
+    p.groupBuffer = u_KrcGroup;                         \
+    p.factorBuffer = u_KrcRelightFactor;                \
+    p.lightGroups = uint(g_Lighting.krcLightGroups);    \
+    p.ratio = g_Lighting.krcRelightRatio.xyz
+
+#if SHARC_QUERY
+// NRD history confidence (mode 1): 1 the history stays valid, 0 to forget, from the
+// frame factor of the cell of the first hit point. REBLUR then brings its history back to
+// one frame, not to zero: mode 2 (normalisation by S, Denoiser.hlsl) is preferred.
+float KrcHistoryConfidence(in SharcParameters sharcParameters, KrcRelightParameters krcParameters, float3 position, float3 normal)
+{
+    if (g_Lighting.krcDebug == 3)
+        return 0.0f; // diagnostic: history forgotten everywhere
+    const float k = max(KrcGetRelightFactor(sharcParameters, krcParameters, position, normal).x, 1e-4f);
+    return exp(-8.0f * abs(log(k)));
+}
+#endif // SHARC_QUERY
+
+#endif // KRC_RELIGHT_HLSLI
