+// Exact relighting (Libraries/Krc): group of each lamp and "after / before" ratio of each
+// group, computed by KrcRelightHost from the intensities the engine knows.
+void Pathtracer::KrcFillRelight(LightingConstants& constants)
+{
+    constants.krcRelight = m_ui.krcRelight ? 1 : 0;
+
+    m_krcRelightHost.BeginFrame(m_ui.sharcEnableClear);
+    for (int i = 0; i < constants.lightCount; i++)
+    {
+        const LightConstants& light = constants.lights[i];
+        int group = (i < (int)m_krcLightGroup.size()) ? m_krcLightGroup[i] : -1;
+        if (group < 0)
+            group = (light.lightType == LightType_Directional) ? 0 : 3;
+        const float power = light.intensity * (0.2126f * light.color.x + 0.7152f * light.color.y + 0.0722f * light.color.z);
+        m_krcRelightHost.AddLight((uint32_t)i, group, power);
+    }
+    const KrcRelightFrame frame = m_krcRelightHost.EndFrame();
+
+    if (m_ui.sharcEnableClear)
+        m_krcRelightSinceClear = false;
+    constants.krcLightGroups = (int)frame.lightGroups;
+    constants.krcRelightEvent = (m_ui.krcRelight && frame.event) ? 1 : 0;
+    m_krcRelightSinceClear = m_krcRelightSinceClear || constants.krcRelightEvent != 0;
+    constants.krcRelightRatio = dm::float4(frame.ratio[0], frame.ratio[1], frame.ratio[2], m_krcRelightSinceClear ? 1.0f : 0.0f);
+    m_krcRelightEvents = constants.krcRelightEvent;
+}
