index 0000000..310f3b9
--- /dev/null
+++ b/Samples/Pathtracer/Shaders/KrcAdaptive.hlsli
@@ -0,0 +1,164 @@
+/*
+ * krc branch: KRC's adaptive cells (KRC-A) on SHaRC's hash table.
+ *
+ * Each fine cell (SHaRC's) has a parent twice as large, in the same table, marked
+ * by bit 63 of the key (reserved by SHaRC for user data; reactive lighting, which
+ * uses it, is disabled in this sample). A fine cell's frame sums are added
+ * to its parent (krcPropagate, before SHaRC's resolve), which resolves like the others.
+ *
+ * Reading blends fine and parent (James-Stein shrinkage): where they do not differ by more
+ * than their uncertainty (frame-to-frame variance of their mean, scaled to the number of
+ * accumulated frames), the parent is read, with many more samples; where the light really changes at
+ * the parent's scale (edge, shadow), the fine one is read, with no leak.
+ *
+ * Requires SharcCommon.h and u_KrcMoments (float4 per entry: running mean of the frame's mean
+ * luminance, of its square, number of counted frames).
+ */
+
+#ifndef KRC_ADAPTIVE_HLSLI
+#define KRC_ADAPTIVE_HLSLI
+
+static const HashGridKey KRC_MOTHER_BIT = HashGridKey(1) << 63;
+
+bool KrcIsMother(HashGridKey key)
+{
+    return (key & KRC_MOTHER_BIT) != 0;
+}
+
+// parent key: position divided by 2, level + 1 (cell twice as large), same
+// normal class
+HashGridKey KrcMotherKey(HashGridKey key)
+{
+    int3 p;
+    p.x = int((key >> (HASH_GRID_POSITION_BIT_NUM * 0)) & HASH_GRID_POSITION_BIT_MASK);
+    p.y = int((key >> (HASH_GRID_POSITION_BIT_NUM * 1)) & HASH_GRID_POSITION_BIT_MASK);
+    p.z = int((key >> (HASH_GRID_POSITION_BIT_NUM * 2)) & HASH_GRID_POSITION_BIT_MASK);
+    p = (p << (32 - HASH_GRID_POSITION_BIT_NUM)) >> (32 - HASH_GRID_POSITION_BIT_NUM);
+    p = p >> 1; // integer division towards -infinity
+    uint level = uint((key >> HASH_GRID_LEVEL_BIT_OFFSET) & HASH_GRID_LEVEL_BIT_MASK);
+    level = min(level + 1, HASH_GRID_LEVEL_BIT_MASK);
+    HashGridKey m = ((HashGridKey(p.x) & HASH_GRID_POSITION_BIT_MASK) << (HASH_GRID_POSITION_BIT_NUM * 0))
+                  | ((HashGridKey(p.y) & HASH_GRID_POSITION_BIT_MASK) << (HASH_GRID_POSITION_BIT_NUM * 1))
+                  | ((HashGridKey(p.z) & HASH_GRID_POSITION_BIT_MASK) << (HASH_GRID_POSITION_BIT_NUM * 2))
+                  | ((HashGridKey(level) & HASH_GRID_LEVEL_BIT_MASK) << HASH_GRID_LEVEL_BIT_OFFSET);
+    m |= key & (HashGridKey(HASH_GRID_NORMAL_BIT_MASK) << HASH_GRID_NORMAL_BIT_OFFSET);
+    return m | KRC_MOTHER_BIT;
+}
+
+// propagation pass (before the resolve): a fine cell's frame sums also go
+// to its parent, created if needed
+void KrcPropagateEntry(uint entryIndex, SharcParameters sharcParameters)
+{
+    if (entryIndex >= sharcParameters.hashGridData.capacity)
+        return;
+    const HashGridKey key = BUFFER_AT_OFFSET(sharcParameters.hashGridData.hashEntriesBuffer, entryIndex);
+    if (key == HASH_GRID_INVALID_HASH_KEY || KrcIsMother(key))
+        return;
+    const SharcAccumulationData acc = BUFFER_AT_OFFSET(sharcParameters.accumulationBuffer, entryIndex);
+    if (acc.data.w == 0)
+        return;
+    const HashGridKey motherKey = KrcMotherKey(key);
+    const uint baseSlot = HashGridGetBaseSlot(motherKey, sharcParameters.hashGridData.capacity);
+    HashGridIndex motherIndex;
+    uint bucketOffset;
+    if (!HashGridInsert(sharcParameters.hashGridData, motherKey, baseSlot, HASH_GRID_HASH_MAP_BUCKET_SIZE, motherIndex, bucketOffset))
+        return;
+    if (acc.data.x != 0) InterlockedAdd(BUFFER_AT_OFFSET(sharcParameters.accumulationBuffer, motherIndex).data.x, acc.data.x);
+    if (acc.data.y != 0) InterlockedAdd(BUFFER_AT_OFFSET(sharcParameters.accumulationBuffer, motherIndex).data.y, acc.data.y);
+    if (acc.data.z != 0) InterlockedAdd(BUFFER_AT_OFFSET(sharcParameters.accumulationBuffer, motherIndex).data.z, acc.data.z);
+    InterlockedAdd(BUFFER_AT_OFFSET(sharcParameters.accumulationBuffer, motherIndex).data.w, acc.data.w);
+}
+
+// before SharcResolveEntry (which clears the frame sums): running mean of the frame's mean
+// luminance and of its square, giving the frame-to-frame variance
+void KrcResolveMoments(uint entryIndex, SharcParameters sharcParameters, uint accumulationFrameNum,
+                       RWStructuredBuffer<float4> moments)
+{
+    if (entryIndex >= sharcParameters.hashGridData.capacity)
+        return;
+    const HashGridKey key = BUFFER_AT_OFFSET(sharcParameters.hashGridData.hashEntriesBuffer, entryIndex);
+    if (key == HASH_GRID_INVALID_HASH_KEY)
+    {
+        moments[entryIndex] = float4(0, 0, 0, 0);
+        return;
+    }
+    const SharcAccumulationData acc = BUFFER_AT_OFFSET(sharcParameters.accumulationBuffer, entryIndex);
+    if (acc.data.w == 0)
+        return;
+    const float sampleNum = float(acc.data.w);
+    const float frameLum = SharcLuma(float3(acc.data.xyz) / (sharcParameters.radianceScale * sampleNum));
+    float4 m = moments[entryIndex];
+    const float frames = min(m.z + 1.0f, float(max(accumulationFrameNum, 1u)));
+    const float a = 1.0f / frames;
+    m.x = lerp(m.x, frameLum, a);
+    m.y = lerp(m.y, frameLum * frameLum, a);
+    m.z = frames;
+    moments[entryIndex] = m;
+}
+
+struct KrcCellRead
+{
+    bool found;
+    float3 radiance;   // demodulated
+    float lum;
+    float varMean;     // variance of the value read (mean over the accumulated frames)
+};
+
+KrcCellRead KrcReadCell(SharcParameters sharcParameters, HashGridKey key, RWStructuredBuffer<float4> moments)
+{
+    KrcCellRead r;
+    r.found = false;
+    r.radiance = float3(0, 0, 0);
+    r.lum = 0;
+    r.varMean = 0;
+    HashGridIndex index;
+    uint bucketOffset;
+    const uint baseSlot = HashGridGetBaseSlot(key, sharcParameters.hashGridData.capacity);
+    if (!HashGridFind(sharcParameters.hashGridData, key, baseSlot, HASH_GRID_HASH_MAP_BUCKET_SIZE, index, bucketOffset))
+        return r;
+    const SharcVoxelData voxel = SharcGetVoxelData(sharcParameters.resolvedBuffer, index);
+    if (voxel.accumulatedSampleNum <= SHARC_SAMPLE_NUM_THRESHOLD)
+        return r;
+    r.found = true;
+    r.radiance = voxel.accumulatedRadiance.radiance;
+    r.lum = SharcLuma(r.radiance);
+    const float4 m = moments[index];
+    r.varMean = max(m.y - m.x * m.x, 0.0f) / max(m.z, 1.0f);
+    return r;
+}
+
+// KRC-A read at the hit point: blend of the fine cell and its parent. tolerance: relative gap
+// below which fine and parent are taken as equal (the parent, less noisy, is read)
+bool KrcGetCachedRadiance(SharcParameters sharcParameters, SharcHitData hitData, float tolerance,
+                          RWStructuredBuffer<float4> moments, out float3 radiance, out float motherWeight)
+{
+    radiance = float3(0, 0, 0);
+    motherWeight = 0;
+    const HashGridKey fineKey = HashGridComputeSpatialHash(hitData.positionWorld, hitData.normalWorld, sharcParameters.hashGridParameters);
+    const KrcCellRead fine = KrcReadCell(sharcParameters, fineKey, moments);
+    const KrcCellRead mother = KrcReadCell(sharcParameters, KrcMotherKey(fineKey), moments);
+    if (!fine.found && !mother.found)
+        return false;
+
+    float w = 0;
+    if (!fine.found)
+        w = 1;
+    else if (mother.found)
+    {
+        const float d = fine.lum - mother.lum;
+        const float tol = tolerance * max(fine.lum, mother.lum);
+        const float d2 = max(d * d - tol * tol, 0.0f);
+        w = fine.varMean / max(fine.varMean + d2 + mother.varMean, 1e-12f);
+    }
+    motherWeight = w;
+    radiance = lerp(fine.radiance, mother.radiance, w);
+#if SHARC_MATERIAL_DEMODULATION
+    radiance *= hitData.materialDemodulation;
+#endif
+#if SHARC_SEPARATE_EMISSIVE
+    radiance += hitData.emissive;
+#endif
+    return true;
+}
+
+#endif // KRC_ADAPTIVE_HLSLI
