     const bool useRayReconstruction = useDlss && m_ui.dlssRayReconstructionSupported && m_ui.denoiserType == DenoiserType::Dlssrr;
     const bool enableDlss = useDlss || useRayReconstruction;
 
+    KrcBenchBeforeRender();
+
     m_pathtracerScene->GetScene()->RefreshSceneGraph(frameIndex);
 
 #if DONUT_WITH_DLSS
@@ -551,6 +554,9 @@ void Pathtracer::Render(nvrhi::IFramebuffer* framebuffer)
     }
 
     m_commandList->open();
+    m_krcTiming = m_krcFpsLeft > 0;
+    if (m_krcTiming)
+        m_commandList->beginTimerQuery(m_krcTimer);
 
     if (m_accelStructBuilder->NeedsRebuild())
     {
@@ -1053,8 +1059,11 @@ void Pathtracer::Render(nvrhi::IFramebuffer* framebuffer)
         m_commandList->draw(args);
     }
 
+    if (m_krcTiming)
+        m_commandList->endTimerQuery(m_krcTimer);
     m_commandList->close();
     device->executeCommandList(m_commandList);
+    KrcBenchAfterRender();
 
     m_resetAccumulation = false;
     m_pathtracerScene->ClearReloaded();
