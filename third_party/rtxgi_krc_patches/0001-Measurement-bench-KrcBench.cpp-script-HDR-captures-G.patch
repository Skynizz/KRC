+/*
+ * krc branch: measurement bench of the sample path tracer, driven by environment variables,
+ * to compare radiance caches (reference, SHaRC, NRC, KRC) on the same image.
+ *
+ *   KRC_HIDDEN=1     window never shown or activated; rendering goes on (measurements while
+ *                    the screen is used for something else)
+ *   KRC_OUT=folder   outputs: PFM images (linear HDR, what the tone curve reads), fps.txt
+ *   KRC_SCRIPT=10:tech=sharc;10:den=nrd;300:capture=sharc_f300;400:exit
+ *     tech=ref|sharc|nrc|krc   method (ref: full paths without a cache)
+ *     den=none|acc|nrd         denoiser (acc: mean of the frames as long as nothing moves)
+ *     spp=N, bounces=N         samples per pixel, bounces
+ *     jitter=0|1               sub-pixel offset (0: same sampling as NRD)
+ *     cam=px,py,pz,tx,ty,tz    camera: position and target point
+ *     sun=S                    sun irradiance (20 by default in the scene)
+ *     sky=S                    sky intensity (8 by default)
+ *     capture=name             image of the frame (HDR) in KRC_OUT/name.pfm
+ *     fps=N                    mean GPU time over N frames, appended to KRC_OUT/fps.txt
+ *     clear                    clears the cache (SHaRC)
+ *     exit                     quitte
+ */
+
+#include "Pathtracer.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <sstream>
+
+#include <GLFW/glfw3.h>
+
+using namespace donut;
+
+namespace
+{
+
+std::vector<float> SplitFloats(const std::string& s)
+{
+    std::vector<float> v;
+    std::stringstream ss(s);
+    std::string item;
+    while (std::getline(ss, item, ','))
+        v.push_back((float)std::atof(item.c_str()));
+    return v;
+}
+
+} // namespace
+
+bool Pathtracer::ShouldRenderUnfocused()
+{
+    return true;
+}
+
+void Pathtracer::KrcBenchInit()
+{
+    if (const char* s = std::getenv("KRC_OUT"))
+        m_krcOut = s;
+    if (const char* s = std::getenv("KRC_SCRIPT"))
+    {
+        std::stringstream ss(s);
+        std::string item;
+        while (std::getline(ss, item, ';'))
+        {
+            const size_t colon = item.find(':');
+            if (colon == std::string::npos)
+                continue;
+            KrcCommand c;
+            c.frame = (uint32_t)std::strtoul(item.substr(0, colon).c_str(), nullptr, 10);
+            const std::string rest = item.substr(colon + 1);
+            const size_t eq = rest.find('=');
+            c.key = rest.substr(0, eq);
+            c.value = eq == std::string::npos ? "" : rest.substr(eq + 1);
+            m_krcCommands.push_back(c);
+        }
+    }
+    m_krcTimer = GetDevice()->createTimerQuery();
+}
+
+void Pathtracer::KrcBenchBeforeRender()
+{
+    m_krcCaptureName.clear();
+    for (const KrcCommand& c : m_krcCommands)
+    {
+        if (c.frame != m_krcFrame)
+            continue;
+        if (c.key == "tech")
+        {
+            if (c.value == "ref")
+                m_ui.techSelection = TechSelection::None;
+            else if (c.value == "sharc")
+                m_ui.techSelection = TechSelection::Sharc;
+#if ENABLE_NRC
+            else if (c.value == "nrc")
+                m_ui.techSelection = TechSelection::Nrc;
+#endif
+            m_resetAccumulation = true;
+        }
+        else if (c.key == "den")
+        {
+            if (c.value == "none")
+                m_ui.denoiserType = DenoiserType::None;
+            else if (c.value == "acc")
+                m_ui.denoiserType = DenoiserType::Accumulation;
+            else if (c.value == "nrd")
+                m_ui.denoiserType = DenoiserType::Nrd;
+            m_resetAccumulation = true;
+        }
+        else if (c.key == "jitter")
+        {
+            // 0 to compare a denoised frame (NRD turns jitter off) with a reference at the same
+            // sampling: otherwise every edge differs
+            m_ui.enableJitter = std::atoi(c.value.c_str()) != 0;
+            m_resetAccumulation = true;
+        }
+        else if (c.key == "spp")
+            m_ui.samplesPerPixel = std::max(1, std::atoi(c.value.c_str()));
+        else if (c.key == "bounces")
+            m_ui.bouncesMax = std::max(1, std::atoi(c.value.c_str()));
+        else if (c.key == "cam")
+        {
+            const std::vector<float> v = SplitFloats(c.value);
+            if (v.size() >= 6)
+                m_camera.LookAt(dm::float3(v[0], v[1], v[2]), dm::float3(v[3], v[4], v[5]));
+        }
+        else if (c.key == "sun")
+        {
+            m_pathtracerScene->GetSunLight()->irradiance = (float)std::atof(c.value.c_str());
+            m_resetAccumulation = true;
+        }
+        else if (c.key == "sky")
+        {
+            m_ui.skyIntensity = (float)std::atof(c.value.c_str());
+            m_resetAccumulation = true;
+        }
+        else if (c.key == "capture")
+            m_krcCaptureName = c.value;
+        else if (c.key == "fps")
+        {
+            m_krcFpsLeft = m_krcFpsFrames = (uint32_t)std::max(1, std::atoi(c.value.c_str()));
+            m_krcGpuSum = 0.0;
+            m_krcGpuCount = 0;
+        }
+        else if (c.key == "clear")
+            m_ui.sharcEnableClear = true;
+        else if (c.key == "exit")
+            m_krcExit = true;
+    }
+}
+
+void Pathtracer::KrcBenchAfterRender()
+{
+    nvrhi::IDevice* device = GetDevice();
+
+    if (m_ui.sharcEnableClear)
+        m_ui.sharcEnableClear = false;
+
+    // GPU time of the frame (query opened and closed in Render during a measurement): the GPU is
+    // waited for to read it, which slows the frame rate but not the measured time
+    if (m_krcTiming)
+    {
+        device->waitForIdle();
+        if (device->pollTimerQuery(m_krcTimer))
+        {
+            m_krcGpuSum += device->getTimerQueryTime(m_krcTimer) * 1000.0;
+            m_krcGpuCount++;
+        }
+        device->resetTimerQuery(m_krcTimer);
+        m_krcTiming = false;
+        if (--m_krcFpsLeft == 0 && !m_krcOut.empty())
+        {
+            if (FILE* f = std::fopen((m_krcOut + "/fps.txt").c_str(), "a"))
+            {
+                std::fprintf(f, "frame %u tech %u gpu_ms %.4f frames %u\n", m_krcFrame, (uint32_t)m_ui.techSelection,
+                             m_krcGpuSum / std::max(1u, m_krcGpuCount), m_krcGpuCount);
+                std::fclose(f);
+            }
+        }
+    }
+
+    if (!m_krcCaptureName.empty() && !m_krcOut.empty())
+        KrcCapture(m_krcOut + "/" + m_krcCaptureName + ".pfm");
+
+    m_krcFrame++;
+    if (m_krcExit)
+        glfwSetWindowShouldClose(GetDeviceManager()->GetWindow(), 1);
+}
+
+// HDR image read by the tone curve: the accumulation if it is active, otherwise the output of
+// the path tracer (denoised if NRD); as PFM (rgb floats, rows from bottom to top)
+void Pathtracer::KrcCapture(const std::string& path)
+{
+    nvrhi::IDevice* device = GetDevice();
+    const bool accumulated = m_ui.denoiserType == DenoiserType::Accumulation;
+    nvrhi::ITexture* source = accumulated ? m_accumulationBuffer.Get() : m_renderTargets->outPathTracer.Get();
+    if (!source)
+        return;
+
+    nvrhi::TextureDesc desc = source->getDesc();
+    desc.isUAV = false;
+    desc.isRenderTarget = false;
+    desc.initialState = nvrhi::ResourceStates::CopyDest;
+    desc.keepInitialState = true;
+    desc.debugName = "KrcCaptureStaging";
+    nvrhi::StagingTextureHandle staging = device->createStagingTexture(desc, nvrhi::CpuAccessMode::Read);
+
+    nvrhi::CommandListHandle cmd = device->createCommandList();
+    cmd->open();
+    cmd->copyTexture(staging, nvrhi::TextureSlice(), source, nvrhi::TextureSlice());
+    cmd->close();
+    device->executeCommandList(cmd);
+    device->waitForIdle();
+
+    size_t pitch = 0;
+    const uint8_t* data = (const uint8_t*)device->mapStagingTexture(staging, nvrhi::TextureSlice(), nvrhi::CpuAccessMode::Read, &pitch);
+    if (!data)
+        return;
+    const uint32_t w = desc.width, h = desc.height;
+    std::vector<float> rgb((size_t)w * h * 3);
+    const bool half = desc.format == nvrhi::Format::RGBA16_FLOAT;
+    for (uint32_t y = 0; y < h; y++)
+    {
+        const uint8_t* row = data + (size_t)(h - 1 - y) * pitch; // PFM: bottom to top
+        for (uint32_t x = 0; x < w; x++)
+        {
+            for (uint32_t c = 0; c < 3; c++)
+            {
+                float v;
+                if (half)
+                {
+                    const uint16_t hv = ((const uint16_t*)row)[x * 4 + c];
+                    const uint32_t sign = (hv >> 15) & 1, exp = (hv >> 10) & 0x1f, man = hv & 0x3ff;
+                    v = exp == 0 ? std::ldexp((float)man, -24) : (exp == 31 ? 65504.0f : std::ldexp((float)(man | 0x400), (int)exp - 25));
+                    if (sign)
+                        v = -v;
+                }
+                else
+                    v = ((const float*)row)[x * 4 + c];
+                rgb[((size_t)y * w + x) * 3 + c] = v;
+            }
+        }
+    }
+    device->unmapStagingTexture(staging);
+
+    if (FILE* f = std::fopen(path.c_str(), "wb"))
+    {
+        std::fprintf(f, "PF\n%u %u\n-1.0\n", w, h);
+        std::fwrite(rgb.data(), sizeof(float), rgb.size(), f);
+        std::fclose(f);
+    }
+}
