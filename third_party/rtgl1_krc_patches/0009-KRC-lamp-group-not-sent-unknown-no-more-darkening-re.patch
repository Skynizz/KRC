From d87cd5126181eed9b0d84c3ca6251bc9d4d9c403 Mon Sep 17 00:00:00 2001
From: Skynizz <182822215+Skynizz@users.noreply.github.com>
Date: Sat, 24 Oct 2026 15:47:59 +0200
Subject: [PATCH 9/9] KRC: lamp group not sent = unknown (no more darkening), reflections by SHaRC's rule
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- The game drops lamps from one frame to the next: a missing group had a ratio of 0 that
  darkened cells and denoiser with no way back; it is now unknown.
- Reflections: cell read only if the cone covers it (like SHaRC), otherwise RTGL1's path.

---
 Source/KrcTools.cpp                  |  5 ++++-
 Source/Shaders/RtRaygenIndirect.rgen | 14 ++++----------
 2 files changed, 8 insertions(+), 11 deletions(-)

diff --git a/Source/KrcTools.cpp b/Source/KrcTools.cpp
index 759a813..21c1880 100644
--- a/Source/KrcTools.cpp
+++ b/Source/KrcTools.cpp
@@ -398,7 +398,10 @@ const std::vector<float> &KrcLightGroups::Ratios() const
         const uint32_t before = i < countPrev.size() ? countPrev[i] : 0;
         if (s.count == 0)
         {
-            ratios[i] = before > 0 ? 0.0f : 1.0f; // the group disappeared: its light is gone
+            // the group was not sent: the game drops lamps from one frame to the next. A
+            // ratio of 0 darkened cells and denoiser with no way back (when they return, the
+            // lamps are "new"): unknown, the correlated paths measure the change
+            ratios[i] = before > 0 ? -1.0f : 1.0f;
         }
         else if (s.unknown || s.count != before || s.rmax - s.rmin > 0.01f * s.rmax + 1e-6f)
         {
diff --git a/Source/Shaders/RtRaygenIndirect.rgen b/Source/Shaders/RtRaygenIndirect.rgen
index b1090b6..055dacc 100644
--- a/Source/Shaders/RtRaygenIndirect.rgen
+++ b/Source/Shaders/RtRaygenIndirect.rgen
@@ -234,17 +234,11 @@ vec3 processBounce(
         throughput_First *= h.albedo;
         rayHitDistance = length(h.hitPosition - surfPosition);
 
-        // KRC: at the hit point, the second bounce is read from the cells (every bounce, no
-        // ray); for the denoiser, the same reflection with the previous lighting (emission does not
-        // change, the lamps' light follows the cells' ratios)
-        if (krcHit)
+        // KRC: where the cell does not fit (SHaRC's rule above), RTGL1's path, like
+        // SHaRC; for the denoiser, the reflection with the previous lighting follows the direct light
+        if (krcHit && rcSpecularBounce)
         {
-            const vec3 emitted = h.emission * h.albedo;
-            if (rcSpecularBounce)
-            {
-                rcSpecOld = emitted + (diffuse / max(krcSignal.x, 1e-3) + krcValue / max(krcSignal.z, 1e-3)) * throughput_First;
-            }
-            return emitted + (diffuse + krcValue) * throughput_First;
+            rcSpecOld = vec3(-1.0);
         }
 
         vec3 bounceDir_Second;
-- 
