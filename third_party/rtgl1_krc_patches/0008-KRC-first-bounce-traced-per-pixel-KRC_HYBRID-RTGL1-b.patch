From 48d93251a657d22221f164c92407351bd541b8d8 Mon Sep 17 00:00:00 2001
From: Skynizz <182822215+Skynizz@users.noreply.github.com>
Date: Sat, 24 Oct 2026 15:24:17 +0200
Subject: [PATCH 8/9] KRC: first bounce traced per pixel (KRC_HYBRID), RTGL1 blue noise, units of reused cells
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- KRC_HYBRID: 0 cells at the pixel; 1 bounce traced where the neighbouring cells disagree
  beyond their uncertainty; 2 always (like SHaRC), KRC cache read at the hit point, second
  bounce traced if there is no cell (point off screen).
- First-bounce sampling with RTGL1's blue noise: white random numbers gave 4 times more
  noise after the denoiser.
- A cell reused at a point (path resampling, traced bounce, reflections) gives
  the received light by evaluating its spherical harmonics with the normal: the raw value,
  weighted by 1/cos, was about twice as large for a uniform light.

---
 Source/RadianceCache.cpp       |  8 +++-
 Source/RadianceCache.h         |  3 ++
 Source/Shaders/RadianceCache.h | 34 +++++++++++--
 Source/Shaders/RtCache.inl     | 88 +++++++++++++++++++++++++++++++++-
 4 files changed, 126 insertions(+), 7 deletions(-)

diff --git a/Source/RadianceCache.cpp b/Source/RadianceCache.cpp
index 0d00f3d..11c6841 100644
--- a/Source/RadianceCache.cpp
+++ b/Source/RadianceCache.cpp
@@ -45,6 +45,9 @@ RadianceCache::RadianceCache(VkDevice _device, const std::shared_ptr<MemoryAlloc
     mode = (int)EnvFloat("KRC_MODE", 0);
     fireflyFactor = EnvFloat("KRC_FIREFLY", 50);
     emitPhys = EnvFloat("KRC_EMIT_PHYS", 0) != 0;
+    hybrid = (uint32_t)EnvFloat("KRC_HYBRID", 1);
+    traceContrast = EnvFloat("KRC_TRACE_CONTRAST", 0.3f);
+    traceSigma = EnvFloat("KRC_TRACE_SIGMA", 1.0f);
 
     // method, debugging, SHaRC scale (50: SDK sample; voxel ≈ distance / scale), accumulation
     float p[5][4] = {
@@ -138,8 +141,9 @@ void RadianceCache::FillUniform(ShGlobalUniform *gu, uint32_t frameIndex, uint32
     Split(curToPrevPoly[frameIndex].GetAddress(), &gu->rcAddrI[0], &gu->rcAddrI[1]);
     Split(groupRatio[frameIndex].GetAddress(), &gu->rcAddrI[2], &gu->rcAddrI[3]);
     Split(krcViews.GetAddress(), &gu->rcAddrJ[0], &gu->rcAddrJ[1]);
-    gu->rcAddrJ[2] = 0;
-    gu->rcAddrJ[3] = 0;
+    gu->rcAddrJ[2] = hybrid;   // KRC_HYBRID: 0 never, 1 where the cells disagree, 2 always
+    // KRC_TRACE_CONTRAST in thousandths, KRC_TRACE_SIGMA in hundredths
+    gu->rcAddrJ[3] = (uint32_t)(traceContrast * 1000.0f) | ((uint32_t)(traceSigma * 100.0f) << 16);
     gu->rcKrc[0] = KRC_TABLE - 1;
     gu->rcKrc[1] = KRC_CELLS;
     gu->rcKrc[2] = KRC_MAX_PIXELS;
diff --git a/Source/RadianceCache.h b/Source/RadianceCache.h
index 11b047a..5b4a8fe 100644
--- a/Source/RadianceCache.h
+++ b/Source/RadianceCache.h
@@ -52,6 +52,9 @@ private:
     float camPosPrev[3] = {};
     float fireflyFactor = 50;
     bool emitPhys = false;
+    uint32_t hybrid = 1;
+    float traceContrast = 0.3f;
+    float traceSigma = 1.0f;
     uint32_t refEpoch = 0;
     float params[5][4] = {};
 
diff --git a/Source/Shaders/RadianceCache.h b/Source/Shaders/RadianceCache.h
index e41e8af..5b00255 100644
--- a/Source/Shaders/RadianceCache.h
+++ b/Source/Shaders/RadianceCache.h
@@ -352,9 +352,20 @@ void krc_view_pack(KrcCell cell, uint clock, out uvec4 a, out uvec4 b, out uvec4
 // Built-in denoiser: indirect of a point reconstructed from the 4 neighbouring cells in the
 // plane of its face (bilinear interpolation), weighted by their confidence. Deterministic: nothing to
 // accumulate or filter afterwards.
+// thresholds of the traced first bounce (pass 8): cell gap from which to trace (fully traced
+// at twice that); number of standard errors of the cells removed from that gap
+#define KRC_TRACE_CONTRAST (float(globalUniform.rcAddrJ.w & 0xffffu) * (1.0 / 1000.0))
+#define KRC_TRACE_SIGMA    (float(globalUniform.rcAddrJ.w >> 16) * (1.0 / 100.0))
+
+// contrast: gap between the neighbouring cells read ((max - min) / max of the luminances), minus
+// their uncertainty (3 standard errors): high only near a real edge, or where the lighting
+// varies faster than the cell size (smoothing would leak there), not in the noise of the areas
+// sombres
 bool krc_smooth_lookup(vec3 p, vec3 n, out vec3 value, out vec4 signal, out vec3 dirR, out vec3 dirG,
-                       out vec3 dirB, out vec3 direct)
+                       out vec3 dirB, out vec3 direct, out float contrast)
 {
+    contrast = 1.0;
+    float lmin = 1e30, lmax = 0.0, rseMax = 0.0;
     value = vec3(0);
     signal = vec4(0);
     vec3 momR = vec3(0), momG = vec3(0), momB = vec3(0);
@@ -395,6 +406,11 @@ bool krc_smooth_lookup(vec3 p, vec3 n, out vec3 value, out vec4 signal, out vec3
             signal.y += w * cv.conf;
             signal.z += w * cv.relightInd;
             w = max(w, 1e-3) * cv.weight;
+            const float lc = rc_lum(cv.mean);
+            lmin = min(lmin, lc);
+            lmax = max(lmax, lc);
+            // relative error of the cell mean, recovered from its confidence
+            rseMax = max(rseMax, RC_KRC_DN_ERR * sqrt(max(1.0 / max(cv.conf, 1e-3) - 1.0, 0.0)));
             value += w * cv.mean;
             momR += w * cv.mean.r * cv.dirR;
             momG += w * cv.mean.g * cv.dirG;
@@ -407,6 +423,7 @@ bool krc_smooth_lookup(vec3 p, vec3 n, out vec3 value, out vec4 signal, out vec3
         return false;
     signal = (wbil > 0.0) ? signal / wbil : vec4(1.0, 0.0, 1.0, 0.0);
     value /= wsum;
+    contrast = (lmax > 1e-6) ? max((lmax - lmin) / lmax - KRC_TRACE_SIGMA * rseMax, 0.0) : 0.0;
     dirR = krc_channel_dir(momR / wsum, value.r);
     dirG = krc_channel_dir(momG / wsum, value.g);
     dirB = krc_channel_dir(momB / wsum, value.b);
@@ -427,8 +444,19 @@ SH krc_sh(vec3 value, vec3 dirR, vec3 dirG, vec3 dirB, vec3 n)
     return sh;
 }
 
+// Light received at the point of normal n according to a cell, in the units of RTGL1's direct
+// light (what a vertex multiplies by its albedo): the evaluation of its spherical harmonics,
+// as for the display. The raw value does not fit: each sample in it is weighted by
+// 1 / cos (RTGL1's first-bounce convention, which the reconstruction compensates); it is worth
+// about twice as much for a uniform light.
+vec3 krc_irradiance(vec3 mean, vec3 dirR, vec3 dirG, vec3 dirB, vec3 n)
+{
+    return max(mean * (0.25 + 0.5 * vec3(dot(dirR, n), dot(dirG, n), dot(dirB, n))), vec3(0));
+}
+
 // A single cell, the one containing the point (for a reflection: the lobe and the specular
-// denoiser already smooth; four times fewer lookups than krc_smooth_lookup)
+// denoiser already smooth; four times fewer lookups than krc_smooth_lookup). value: the
+// light received at the point (krc_irradiance), not the raw value of the cell.
 bool krc_point_lookup(vec3 p, vec3 n, out vec3 value, out vec4 signal, out vec3 direct, out float size)
 {
     value = vec3(0);
@@ -444,7 +472,7 @@ bool krc_point_lookup(vec3 p, vec3 n, out vec3 value, out vec4 signal, out vec3
                                        krc_views().v[KRC_VIEW_WORDS * c + 2u], uint(krc_ctr().v[KRC_C_CLOCK]));
     if (cv.weight <= 0.0)
         return false;
-    value = cv.mean;
+    value = krc_irradiance(cv.mean, cv.dirR, cv.dirG, cv.dirB, n);
     direct = cv.direct;
     signal = vec4(cv.relight, cv.conf, cv.relightInd, 1.0);
     return true;
diff --git a/Source/Shaders/RtCache.inl b/Source/Shaders/RtCache.inl
index 5fcd8d0..218bd0b 100644
--- a/Source/Shaders/RtCache.inl
+++ b/Source/Shaders/RtCache.inl
@@ -585,7 +585,10 @@ void krc_path(RcSurface s, vec3 toViewer, bool reference, out vec3 value, out ve
                 const uint c = krc_find(key);
                 if (c != KRC_NONE && krc_cells().c[c].n >= 8.0)
                 {
-                    const vec3 cached = krc_cells().c[c].mean;
+                    const KrcCell hc = krc_cells().c[c];
+                    const vec3 cached = krc_irradiance(hc.mean, krc_channel_dir(hc.momR, hc.mean.r),
+                                                       krc_channel_dir(hc.momG, hc.mean.g),
+                                                       krc_channel_dir(hc.momB, hc.mean.b), h.normalGeom);
                     value += beta * (h.albedo * (d.dnew + cached) + emissive);
                     old += beta * (h.albedo * (d.dold + cached) + emissive);
                     return;
@@ -1027,6 +1030,66 @@ void krc_resolve(uint id)
         acc.v[b + i] = 0;
 }
 
+// First bounce traced for a pixel (like SHaRC): diffuse ray sampled like RTGL1, then at the hit
+// point its emission, its direct light and its indirect read from the cells (the direct
+// light computed if the point is too close for the cell). Same quantity as the value of the
+// cells.
+// RTGL1's sampling (the pixel's blue noise, same salts as getDiffuseBounce and the direct light of
+// its bounce): white random numbers gave 4 times more noise after the denoiser.
+vec3 krc_first_bounce(RcSurface s, uint seed, out vec3 dir)
+{
+    float oneOverPdf;
+    const vec2 u = getRandomSample(seed, RANDOM_SALT_DIFF_BOUNCE(0)).xy;
+    dir = sampleLambertian(s.normalGeom, u.x, u.y, oneOverPdf);
+    const ShPayload p = traceIndirectRay(s.instCustomIndex, s.position + s.normalGeom * 0.01, dir);
+    const vec3 w1 = vec3(evalBRDFLambertian(1.0) * oneOverPdf);
+    RcSurface h;
+    float segment;
+    if (!rc_hit_surface(p, s, 1, h, segment))
+        return w1 * getSky(dir);
+    vec3 cellValue, cellDirect;
+    vec4 cellSignal;
+    float cellSize;
+    const bool found = krc_point_lookup(h.position, h.normalGeom, cellValue, cellSignal, cellDirect, cellSize);
+    vec3 light;
+    if (found && segment > cellSize * 1.7320508)
+        light = cellDirect + cellValue;
+    else
+    {
+        vec3 diffuse, specular;
+        processDirectIllumination(seed, h.instCustomIndex, h.position, h.normal, h.normalGeom, h.roughness,
+                                  getSpecularColor(h.albedo, h.metallic), h.sector, -dir, false, 1, diffuse, specular);
+        light = diffuse;
+        if (found)
+        {
+            light += cellValue;
+        }
+        else
+        {
+            // no cell (point outside the camera's view): the second bounce is traced, like RTGL1
+            float pdf2;
+            const vec2 u2 = getRandomSample(seed, RANDOM_SALT_DIFF_BOUNCE(1)).xy;
+            const vec3 dir2 = sampleLambertian(h.normalGeom, u2.x, u2.y, pdf2);
+            const ShPayload p2 = traceIndirectRay(h.instCustomIndex, h.position + h.normalGeom * 0.01, dir2);
+            RcSurface h2;
+            float segment2;
+            if (rc_hit_surface(p2, h, 2, h2, segment2))
+            {
+                vec3 diffuse2, specular2;
+                processDirectIllumination(seed, h2.instCustomIndex, h2.position, h2.normal, h2.normalGeom, h2.roughness,
+                                          getSpecularColor(h2.albedo, h2.metallic), h2.sector, -dir2, false, 2,
+                                          diffuse2, specular2);
+                light += h2.emission * h2.albedo + h2.albedo * diffuse2;
+            }
+            else
+            {
+                light += getSky(dir2);
+            }
+        }
+    }
+    return w1 * (h.emission * h.albedo + h.albedo * light);
+}
+
 // Pass 8, after RTGL1's indirect: the pixel's diffuse indirect read from the neighbouring cells
 // (same quantity as RTGL1's diffuse bounce, with every bounce, no ray; mean direction
 // of the cells), and what KRC tells the denoiser. Outside the indirect-ray shader: the
@@ -1045,10 +1108,17 @@ void krc_display(ivec2 pix)
 
     vec3 value, dirR, dirG, dirB, cellDirect;
     vec4 sig;
+    float contrast;
     SH sh = newSH();
-    if (krc_smooth_lookup(s.position, s.normalGeom, value, sig, dirR, dirG, dirB, cellDirect))
+    // traced share: where the neighbouring cells disagree (edge, lighting varying faster
+    // than the cells), a real first bounce; elsewhere, the smooth value of the cells,
+    // with no ray and no noise. (The cells' confidence is not used here: with heavy-tailed
+    // paths, almost all of them fall below the threshold and everything would be traced.)
+    float traced = 1.0;
+    if (krc_smooth_lookup(s.position, s.normalGeom, value, sig, dirR, dirG, dirB, cellDirect, contrast))
     {
         sh = krc_sh(value, dirR, dirG, dirB, s.normalGeom);
+        traced = clamp((contrast - KRC_TRACE_CONTRAST) / KRC_TRACE_CONTRAST, 0.0, 1.0);
         // debugging: ratios for the denoiser, red = direct > 1.05, blue = direct < 0.95,
         // green = indirect outside [0.95, 1.05]
         if (RC_DEBUG == 8)
@@ -1061,6 +1131,20 @@ void krc_display(ivec2 pix)
     {
         sig = vec4(1.0, 0.0, 1.0, 1.0);
     }
+    if (globalUniform.rcAddrJ.z == 0u)
+        traced = 0.0;   // KRC_HYBRID=0: never a ray at the pixel
+    else if (globalUniform.rcAddrJ.z == 2u)
+        traced = 1.0;   // KRC_HYBRID=2: always (traced first bounce, like SHaRC)
+    if (traced > 0.0)
+    {
+        vec3 d;
+        const vec3 est = clamp(krc_first_bounce(s, getCurrentRandomSeed(pix), d), vec3(0), vec3(1e4));
+        sh = mixSH(sh, irradianceToSH(est, d), traced);
+        sig.y = 0.0;   // the denoiser accumulates this pixel (a noisy share)
+    }
+    // debug 9: the traced share (red)
+    if (RC_DEBUG == 9)
+        sh = irradianceToSH(vec3(traced * 4.0, 0.0, 0.0), s.normalGeom * (2.0 / 3.0));
     // specular ratio: direct from the pixel's cells, reflection computed at the hit point;
     // exactly 1 when nothing changes
     const float lumOld = spec.x / max(sig.x, 1e-3) + spec.y;
-- 
