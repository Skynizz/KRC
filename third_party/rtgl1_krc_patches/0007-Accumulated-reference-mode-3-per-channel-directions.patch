+// first-order spherical harmonics with one direction per channel (irradianceToSH, channel by channel).
+// A short direction is a measurement (grazing light or light from opposite sides: almost zero
+// directional component), not a missing measurement: replacing it with 2/3 of the normal
+// doubled the lighting of surfaces lit at an angle.
+SH krc_sh(vec3 value, vec3 dirR, vec3 dirG, vec3 dirB, vec3 n)
+{
+    SH sh;
+    sh.r = vec4(0.282095, 0.488603 * dirR.y, 0.488603 * dirR.z, 0.488603 * dirR.x) * value.r;
+    sh.g = vec4(0.282095, 0.488603 * dirG.y, 0.488603 * dirG.z, 0.488603 * dirG.x) * value.g;
+    sh.b = vec4(0.282095, 0.488603 * dirB.y, 0.488603 * dirB.z, 0.488603 * dirB.x) * value.b;
+    return sh;
+}
